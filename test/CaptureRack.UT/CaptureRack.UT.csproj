<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Capture/CaptureRack.Audio/CaptureRack.Audio.csproj" />
    <ProjectReference Include="../../src/Capture/CaptureRack.Core/CaptureRack.Core.csproj" />
    <ProjectReference Include="../../src/Capture/CaptureCards/CaptureRack.DeckLink/CaptureRack.DeckLink.csproj" />
    <ProjectReference Include="../../src/Capture/CaptureRack.DirectShow/CaptureRack.DirectShow.csproj" />
    <ProjectReference Include="../../src/Processing/CaptureRack.QualityControl/CaptureRack.QualityControl.csproj" />
    <ProjectReference Include="../../src/Processing/CaptureRack.Recording/CaptureRack.Recording.csproj" />
    <ProjectReference Include="../../src/Capture/CaptureRack.SignalCapture/CaptureRack.SignalCapture.csproj" />
    <ProjectReference Include="../../src/CaptureRack.DeviceControl/CaptureRack.DeviceControl.csproj" />
    <Compile Include="../../src/UI/CaptureRack.App/CaptureSettings.cs" Link="CaptureSettings.cs" />
    <Compile Include="../../src/UI/CaptureRack.App/SettingsLanguage.cs" Link="SettingsLanguage.cs" />
    <Compile Include="../../src/UI/CaptureRack.App/Architecture/RfSwitchTrigger.cs" Link="RfSwitchTrigger.cs" />
    <Compile Include="../../src/UI/CaptureRack.App/Architecture/RfPreviewAudio.cs" Link="RfPreviewAudio.cs" />
    <Compile Include="../../src/UI/CaptureRack.App/Architecture/CaptureQcLog.cs" Link="CaptureQcLog.cs" />
    <Compile Include="../../src/UI/CaptureRack.App/Architecture/WorkspaceContracts.cs" Link="WorkspaceContracts.cs" />
  </ItemGroup>
  <Import Project="../../RealtimePreview.props" Condition="'$(TestRealtimeRf)' == 'true'" />
  <PropertyGroup Condition="'$(TestRealtimeRf)' == 'true'">
    <DefineConstants>$(DefineConstants);REALTIME_RF</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(TestRealtimeRf)' == 'true'">
    <Compile Include="../../src/UI/CaptureRack.App/Architecture/RfDecoderOptions.cs" Link="RfDecoderOptions.cs" />
    <Compile Include="../../src/UI/CaptureRack.App/Architecture/RfPreviewDecoder.cs" Link="RfPreviewDecoder.cs" />
  </ItemGroup>
</Project>
