<Window
    x:Class="CaptureRack.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CaptureRack.App.Controls"
    xmlns:views="using:CaptureRack.App.Views"
    Title="CaptureRack">
    <Grid x:Name="RootShell" Background="Transparent" SizeChanged="Viewport_SizeChanged"
          KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="PreviewFullscreen_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="ExitPreviewFullscreen_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="TogglePreview_Invoked" />
            <KeyboardAccelerator Key="F9" Invoked="ToggleRecord_Invoked" />
            <KeyboardAccelerator Key="Number1" Modifiers="Control" Invoked="LayoutFocus_Invoked" />
            <KeyboardAccelerator Key="Number2" Modifiers="Control" Invoked="LayoutSplit_Invoked" />
            <KeyboardAccelerator Key="Number3" Modifiers="Control" Invoked="LayoutScopes_Invoked" />
            <KeyboardAccelerator Key="Number4" Modifiers="Control" Invoked="LayoutSpectrum_Invoked" />
            <KeyboardAccelerator Key="Number5" Modifiers="Control" Invoked="LayoutEvents_Invoked" />
            <KeyboardAccelerator Key="I" Modifiers="Control" Invoked="ToggleInspector_Invoked" />
            <KeyboardAccelerator Key="M" Invoked="ToggleAudioMonitor_Invoked" />
            <KeyboardAccelerator Key="Space" Invoked="RfPlayPause_Invoked" />
            <KeyboardAccelerator Key="Left" Invoked="RfStepPrev_Invoked" />
            <KeyboardAccelerator Key="Right" Invoked="RfStepNext_Invoked" />
            <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="RfOpenFile_Invoked" />
        </Grid.KeyboardAccelerators>

        <!-- Custom Studio Title Bar -->
        <Grid x:Name="TitleBarGrid" Height="42" Padding="12,0,0,0"
              Background="{ThemeResource StudioPanelBrush}"
              BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TitleBarRightInset" Width="138" />
            </Grid.ColumnDefinitions>

            <!-- Brand + Workspace Mode Switcher + Multi-Backend Source Rack Switcher -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <StackPanel x:Name="TitleBarBrand" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,4,0">
                    <Border Width="20" Height="20" CornerRadius="3"
                            Background="{ThemeResource StudioCardBrush}"
                            BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1">
                        <Grid>
                            <Border Width="10" Height="10" CornerRadius="1" BorderThickness="1.5"
                                    BorderBrush="{ThemeResource StudioTextSecondaryBrush}" />
                            <Rectangle Width="4" Height="4" RadiusX="1" RadiusY="1"
                                       Fill="{ThemeResource StudioRecBrush}" />
                        </Grid>
                    </Border>
                    <TextBlock Text="CaptureRack" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource StudioTextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Primary Mode Switcher (Capture / QC Center) -->
                <Border x:Name="TitleBarModeSwitcher" Background="{ThemeResource StudioSegmentTrackBrush}"
                        BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="2">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <Button x:Name="CaptureModeButton" Style="{StaticResource StudioSegmentButtonStyle}"
                                Click="CaptureModeButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE714;" FontSize="12" />
                                <TextBlock x:Name="CaptureModeLabel" Text="Capture" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="QcModeButton" Style="{StaticResource StudioSegmentButtonStyle}"
                                Click="QcModeButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE9D5;" FontSize="12" />
                                <TextBlock x:Name="QcModeLabel" Text="QC Center" VerticalAlignment="Center" />
                                <Rectangle x:Name="QcNavBadgeDot" Width="6" Height="6" RadiusX="1" RadiusY="1"
                                           Visibility="Collapsed" Fill="{ThemeResource StudioInfoBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Source Rack Switcher (Multi-Backend Aware) -->
                <Button x:Name="QuickSourceButton" Style="{StaticResource SubtleButtonStyle}"
                        Height="28" Padding="9,0" CornerRadius="4"
                        Background="{ThemeResource StudioCardBrush}"
                        BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Rectangle x:Name="QuickSourceDot" Width="7" Height="7" RadiusX="1" RadiusY="1"
                                   Fill="{ThemeResource StudioTextMutedBrush}" VerticalAlignment="Center" />
                        <FontIcon x:Name="QuickSourceIcon" Glyph="&#xE714;" FontSize="12"
                                  Foreground="{ThemeResource StudioTextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ConfigurationSummary" MaxWidth="520" FontSize="13"
                                   Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                    </StackPanel>
                    <ToolTipService.ToolTip>
                        <ToolTip Placement="Bottom">
                            <TextBlock Text="{x:Bind ConfigurationSummary.Text, Mode=OneWay}"
                                       MaxWidth="560" TextWrapping="Wrap" />
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <Button.Flyout>
                        <Flyout x:Name="SourceRackFlyout" Placement="BottomEdgeAlignedLeft"
                                Opening="SourceRackFlyout_Opening">
                            <StackPanel Width="336" Spacing="10">
                                <TextBlock x:Name="SourceRackHeading" Style="{StaticResource StudioSectionHeadingStyle}" />
                                <TextBlock x:Name="SourceRackLockNotice" FontSize="11" TextWrapping="Wrap"
                                           Visibility="Collapsed" Foreground="{ThemeResource StudioCautionBrush}" />
                                <ItemsControl x:Name="SourceRackList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding BackendId}" IsEnabled="{Binding IsSelectable}"
                                                    Click="SourceRackItem_Click" HorizontalAlignment="Stretch"
                                                    Height="64" HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,8"
                                                    ToolTipService.ToolTip="{Binding Subtitle}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter x:Name="RootContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal" />
                                                                    <VisualState x:Name="PointerOver">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="RootContent.Opacity" Value="0.88" />
                                                                        </VisualState.Setters>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Pressed">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="RootContent.Opacity" Value="0.74" />
                                                                        </VisualState.Setters>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Disabled">
                                                                        <VisualState.Setters>
                                                                            <Setter Target="RootContent.Opacity" Value="0.55" />
                                                                        </VisualState.Setters>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </ContentPresenter>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Border Background="{Binding CardBackground}"
                                                        BorderBrush="{Binding CardBorder}"
                                                        BorderThickness="1" CornerRadius="3" Padding="10,4">
                                                    <Grid ColumnSpacing="9" VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="{Binding IconGlyph}" FontSize="14"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{Binding IconForeground}" />
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" VerticalAlignment="Top" CornerRadius="2" Padding="6,2"
                                                                Visibility="{Binding BadgeVisibility}" Background="{Binding BadgeBackground}">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{Binding BadgeForeground}" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <!-- Continuous Draggable Title Bar Region -->
            <Border x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent" />

            <!-- Right Title Bar Actions -->
            <StackPanel x:Name="TitleBarActions" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button x:Name="ToggleInspectorButton" Style="{StaticResource StudioIconButtonStyle}"
                        Click="ToggleInspectorButton_Click" AutomationProperties.Name="Capture configuration">
                    <FontIcon x:Name="ToggleInspectorIcon" Glyph="&#xE90C;" FontSize="14" />
                </Button>
                <Button x:Name="OpenSettingsButton" Style="{StaticResource StudioIconButtonStyle}"
                        Click="OpenSettings_Click" AutomationProperties.Name="Settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Content Host -->
        <Grid x:Name="MainContentHost" Grid.Row="1">

            <!-- 1. Live Capture & Monitoring Workspace -->
            <Grid x:Name="WorkspacePage" Padding="10,8,10,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="InspectorDockColumn" Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left/Center Monitoring Stage -->
                <Grid x:Name="StageGrid" RowSpacing="8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="RfPlaybackBar" Grid.Row="2" Visibility="Collapsed"
                            Style="{StaticResource StudioInstrumentCardStyle}" Padding="10,7"
                            AllowDrop="True" DragOver="RfPlaybackBar_DragOver" DragLeave="RfPlaybackBar_DragLeave" Drop="RfPlaybackBar_Drop">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button x:Name="RfOpenFile" Style="{StaticResource StudioTransportPrimaryButtonStyle}"
                                        MinHeight="30" Padding="10,0" Click="RfOpenFile_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon x:Name="RfOpenFileIcon" Glyph="&#xE8E5;" FontSize="12" />
                                        <ProgressRing x:Name="RfOpenFileSpinner" Width="12" Height="12" IsActive="False" Visibility="Collapsed" />
                                        <TextBlock x:Name="RfOpenFileLabel" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RfPlayPauseButton" Style="{StaticResource StudioIconButtonStyle}"
                                        Click="StartButton_Click" VerticalAlignment="Center">
                                    <FontIcon x:Name="RfPlayPauseIcon" Glyph="&#xE768;" FontSize="13" />
                                </Button>
                                <Button x:Name="RfStepBack" Style="{StaticResource StudioIconButtonStyle}"
                                        Tag="-1" Click="RfFieldStep_Click" Visibility="Collapsed" VerticalAlignment="Center"
                                        AutomationProperties.Name="Previous field">
                                    <FontIcon Glyph="&#xE892;" FontSize="12" />
                                </Button>
                                <Button x:Name="RfStepForward" Style="{StaticResource StudioIconButtonStyle}"
                                        Tag="1" Click="RfFieldStep_Click" Visibility="Collapsed" VerticalAlignment="Center"
                                        AutomationProperties.Name="Next field">
                                    <FontIcon Glyph="&#xE893;" FontSize="12" />
                                </Button>
                                <ProgressRing x:Name="RfFieldBusyRing" Width="14" Height="14" IsActive="False"
                                              Visibility="Collapsed" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock x:Name="RfPlaybackName" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <Slider x:Name="RfSeek" Minimum="0" Maximum="1" StepFrequency="0.01"
                                        ValueChanged="RfSeek_Changed" />
                            </StackPanel>
                            <TextBlock x:Name="RfPlaybackTime" Grid.Column="2"
                                       Style="{StaticResource StudioMonoTextStyle}" FontSize="12"
                                       Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <!-- De-cluttered Capability-Aware Stage Toolbar -->
                    <Grid x:Name="StageToolbar" ColumnSpacing="8" SizeChanged="StageToolbar_SizeChanged">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <Border x:Name="LayoutSegmentTrack" Background="{ThemeResource StudioSegmentTrackBrush}"
                                    BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1"
                                    CornerRadius="4" Padding="2" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button x:Name="LayoutFocusBtn" Style="{StaticResource StudioSegmentButtonStyle}"
                                            Tag="Focus" Click="LayoutModeButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE714;" FontSize="12" />
                                            <TextBlock x:Name="LayoutFocusLabel" Text="Focus" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LayoutSplitBtn" Style="{StaticResource StudioSegmentButtonStyle}"
                                            Tag="Split" Click="LayoutModeButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE744;" FontSize="12" />
                                            <TextBlock x:Name="LayoutSplitLabel" Text="Studio Split" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LayoutScopesBtn" Style="{StaticResource StudioSegmentButtonStyle}"
                                            Tag="Scopes" Click="LayoutModeButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE9D2;" FontSize="12" />
                                            <TextBlock x:Name="LayoutScopesLabel" Text="Scopes" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LayoutSpectrumBtn" Style="{StaticResource StudioSegmentButtonStyle}"
                                            Tag="Spectrum" Click="LayoutModeButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE9E9;" FontSize="12" />
                                            <TextBlock x:Name="LayoutSpectrumLabel" Text="Spectrum" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="LayoutEventsBtn" Style="{StaticResource StudioSegmentButtonStyle}"
                                            Tag="Events" Click="LayoutModeButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE81C;" FontSize="12" />
                                            <TextBlock x:Name="LayoutEventsLabel" Text="Events" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <ScrollViewer x:Name="StageOptionsScroll" Grid.Column="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Pluggable Slot: Monitor Bar Options (Video Preview / Audio Monitor / Future RF FFT) -->
                            <ContentPresenter x:Name="RfOptionsSlot" VerticalAlignment="Center"/>
                            <ContentPresenter x:Name="MonitorBarSlot" VerticalAlignment="Center" />

                            <Border x:Name="StageSignalBadge" CornerRadius="3" Padding="9,4"
                                    Background="{ThemeResource StudioCardBrush}"
                                    BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Rectangle x:Name="StageSignalDot" Width="7" Height="7" RadiusX="1" RadiusY="1"
                                               Fill="{ThemeResource StudioTextMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="StageSignalText" FontSize="13"
                                               Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Stage Body: Video Monitor + Draggable Split Divider + Modular Instruments Deck -->
                    <Grid x:Name="MonitorViewport" Grid.Row="1" SizeChanged="MonitorViewport_SizeChanged">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="PreviewStageRow" Height="63*" />
                            <RowDefinition x:Name="SplitDividerRow" Height="Auto" />
                            <RowDefinition x:Name="InstrumentsStageRow" Height="37*" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="RfMeterRack" Grid.RowSpan="3" Orientation="Horizontal" Spacing="3" Margin="0,0,6,0" Visibility="Collapsed">
                            <controls:RfPeakMeter x:Name="RfMeterA"/>
                            <controls:RfPeakMeter x:Name="RfMeterB" Visibility="Collapsed"/>
                        </StackPanel>
                        <!-- Video Monitor Housing -->
                        <Border x:Name="PreviewMonitorHousing" Grid.Column="1" Grid.Row="0" CornerRadius="4"
                                Background="{ThemeResource StudioStageCanvasBrush}"
                                BorderBrush="{ThemeResource StudioMonitorBezelBrush}" BorderThickness="1.5"
                                SizeChanged="PreviewMonitorHousing_SizeChanged"
                                PointerEntered="PreviewSurface_PointerEntered"
                                PointerExited="PreviewSurface_PointerExited">
                            <Grid>
                                <Border x:Name="PreviewRecFrameGlow" Visibility="Collapsed" IsHitTestVisible="False"
                                        CornerRadius="3" BorderThickness="2"
                                        BorderBrush="{ThemeResource StudioRecBrush}" />

                                <Border x:Name="PreviewSurface" Width="480" Height="360"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="#080A0E" CornerRadius="0"
                                        BorderBrush="#24FFFFFF" BorderThickness="1">
                                    <Grid Background="Transparent" Tapped="PreviewSurface_Tapped"
                                          DoubleTapped="PreviewSurface_DoubleTapped">
                                        <Image x:Name="PreviewImage" Stretch="Fill"
                                               AutomationProperties.Name="DeckLink video preview" />

                                        <Grid x:Name="SafeAreaOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                                            <Border Margin="18" BorderBrush="{ThemeResource StudioSafeGuideBrush}"
                                                    BorderThickness="1" Opacity="0.55" />
                                            <Border Margin="36" BorderBrush="{ThemeResource StudioSafeGuideBrush}"
                                                    BorderThickness="1" Opacity="0.35" />
                                            <Rectangle Width="18" Height="1" Fill="{ThemeResource StudioSafeGuideBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" />
                                            <Rectangle Width="1" Height="18" Fill="{ThemeResource StudioSafeGuideBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" />
                                        </Grid>

                                        <Grid x:Name="Ntsc480GuideOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                                            <Border x:Name="Ntsc480TopShade" VerticalAlignment="Top" Height="4"
                                                    Background="#66F59E0B" BorderBrush="#CCF59E0B" BorderThickness="0,0,0,1" />
                                            <Border x:Name="Ntsc480BottomShade" VerticalAlignment="Bottom" Height="2"
                                                    Background="#66F59E0B" BorderBrush="#CCF59E0B" BorderThickness="0,1,0,0" />
                                        </Grid>

                                        <StackPanel x:Name="PreviewPlaceholder" HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" Spacing="12" Margin="20">
                                            <Border Width="44" Height="44" CornerRadius="4" HorizontalAlignment="Center"
                                                    Background="#16FFFFFF" BorderBrush="#2AFFFFFF" BorderThickness="1">
                                                <Grid>
                                                    <FontIcon x:Name="PreviewPlaceholderIcon" Glyph="&#xE714;" FontSize="20" Foreground="#CBD5E1" />
                                                    <ProgressRing x:Name="PreviewPlaceholderSpinner" Width="20" Height="20"
                                                                  IsActive="False" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Spacing="4">
                                                <TextBlock x:Name="PreviewPlaceholderText" Text="Waiting for preview"
                                                           FontSize="14" FontWeight="SemiBold" Foreground="#F1F5F9"
                                                           TextAlignment="Center" TextWrapping="Wrap" />
                                                <TextBlock x:Name="PreviewPlaceholderHint" FontSize="12"
                                                           Foreground="#94A3B8" TextAlignment="Center" TextWrapping="Wrap"
                                                           MaxWidth="320" />
                                            </StackPanel>
                                            <Button x:Name="PlaceholderStartButton" HorizontalAlignment="Center"
                                                    RequestedTheme="Dark" CornerRadius="4" Padding="14,6"
                                                    Click="StartButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE768;" FontSize="12" />
                                                    <TextBlock x:Name="PlaceholderStartLabel" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="PreviewHudPill" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="8" Padding="8,4" CornerRadius="3" Visibility="Collapsed"
                                        Background="{ThemeResource StudioHudBackdropBrush}"
                                        BorderBrush="{ThemeResource StudioHudBorderBrush}" BorderThickness="1"
                                        IsHitTestVisible="False">
                                    <Grid ColumnSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle x:Name="PreviewHudDot" Width="6" Height="6" RadiusX="1" RadiusY="1"
                                                   Fill="{ThemeResource StudioSignalLockBrush}" VerticalAlignment="Top" Margin="0,5,0,0" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock x:Name="PreviewDetail" Style="{StaticResource StudioMonoTextStyle}"
                                                       FontSize="11" Foreground="#F1F5F9" TextWrapping="Wrap" />
                                            <TextBlock x:Name="PreviewAudioDetail" Style="{StaticResource StudioMonoTextStyle}"
                                                       FontSize="11" Foreground="#F1F5F9" TextWrapping="Wrap" Visibility="Collapsed" />
                                            <TextBlock x:Name="PreviewTapeDetail" Style="{StaticResource StudioMonoTextStyle}"
                                                       FontSize="11" Foreground="#F1F5F9" TextWrapping="Wrap" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="PreviewRecTally" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="8" Padding="8,4" CornerRadius="3" Visibility="Collapsed"
                                        Background="#E6B91C1C" BorderBrush="#88FCA5A5" BorderThickness="1"
                                        IsHitTestVisible="False">
                                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                        <Ellipse x:Name="PreviewRecTallyDot" Width="7" Height="7" Fill="#FFFFFF"
                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="REC" Style="{StaticResource StudioMonoTextStyle}"
                                                   FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="2" Height="10" VerticalAlignment="Center">
                                            <Border x:Name="RecBar1" Width="2" Height="10" Background="#FFFFFF"
                                                    RenderTransformOrigin="0.5,1" />
                                            <Border x:Name="RecBar2" Width="2" Height="10" Background="#FFFFFF"
                                                    RenderTransformOrigin="0.5,1" />
                                            <Border x:Name="RecBar3" Width="2" Height="10" Background="#FFFFFF"
                                                    RenderTransformOrigin="0.5,1" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Button x:Name="PreviewFullscreenButton" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Width="36" Height="36" Padding="0" Margin="8" Opacity="0" IsHitTestVisible="False"
                                        RequestedTheme="Dark" CornerRadius="4"
                                        Background="{ThemeResource StudioHudBackdropBrush}"
                                        BorderBrush="{ThemeResource StudioHudBorderBrush}" BorderThickness="1"
                                        Click="PreviewFullscreen_Click" GotFocus="PreviewFullscreen_FocusChanged"
                                        LostFocus="PreviewFullscreen_FocusChanged">
                                    <FontIcon x:Name="PreviewFullscreenIcon" Glyph="&#xE740;" FontSize="15" Foreground="#F8FAFC" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Draggable Studio Split Divider (Native SizeNorthSouth Resize Cursor) -->
                        <controls:SplitResizeHandle x:Name="SplitResizeHandle" Grid.Column="1" Grid.Row="1" Height="10" Background="Transparent"
                                                    ManipulationMode="TranslateY"
                                                    ManipulationDelta="SplitResizeHandle_ManipulationDelta"
                                                    ManipulationCompleted="SplitResizeHandle_ManipulationCompleted"
                                                    PointerEntered="SplitResizeHandle_PointerEntered"
                                                    PointerExited="SplitResizeHandle_PointerExited"
                                                    DoubleTapped="SplitResizeHandle_DoubleTapped">
                            <Border x:Name="SplitResizeGrip" Width="44" Height="3" CornerRadius="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{ThemeResource StudioHairlineBrush}" />
                        </controls:SplitResizeHandle>

                        <Grid x:Name="InstrumentsDeckContainer" Grid.Column="1" Grid.Row="2" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="RfAdcRow" Height="0" />
                                <RowDefinition x:Name="VideoInstrumentsRow" Height="2*" />
                            </Grid.RowDefinitions>
                        <Border x:Name="RfStage" Grid.Row="0" Style="{StaticResource StudioInstrumentCardStyle}"
                                Padding="10,8" Visibility="Collapsed">
                            <Grid RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock x:Name="RfHeading" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource StudioTextPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="RfScopeValue" FontSize="11"
                                                   Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <StackPanel x:Name="RfLegendPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Rectangle Width="8" Height="2" Fill="{ThemeResource StudioSignalLockBrush}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="RfLegendALabel" Text="ADC" Style="{StaticResource StudioMonoTextStyle}"
                                                           FontSize="10" Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel x:Name="RfLegendBPanel" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center" Visibility="Collapsed">
                                                <Rectangle Width="8" Height="2" Fill="{ThemeResource StudioInfoBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="Q" Style="{StaticResource StudioMonoTextStyle}"
                                                           FontSize="10" Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <ComboBox x:Name="RfScopeSource" MinHeight="32" Padding="10,2,30,2" VerticalContentAlignment="Center" CornerRadius="3" SelectedIndex="0"
                                                  SelectionChanged="RfScope_Changed" AutomationProperties.Name="Signal">
                                            <ComboBoxItem x:Name="RfScopeAdcItem" Content="ADC" />
                                            <ComboBoxItem x:Name="RfScopeHeadSwitchItem" Content="Head switch" />
                                            <ComboBoxItem Content="Y · IRE" />
                                            <ComboBoxItem Content="U" />
                                            <ComboBoxItem Content="V" />
                                            <ComboBoxItem Content="RF FFT" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" Background="{ThemeResource StudioStageCanvasBrush}"
                                        BorderBrush="{ThemeResource StudioMonitorBezelBrush}" BorderThickness="1"
                                        CornerRadius="2" Padding="6,5">
                                    <Grid ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid x:Name="RfFftAxis" Grid.Column="1" Grid.Row="1" Visibility="Collapsed">
                                            <TextBlock x:Name="RfFftLow" FontSize="10" Foreground="#9BA5B8"/>
                                            <TextBlock x:Name="RfFftCenter" FontSize="10" Foreground="#9BA5B8" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="RfFftHigh" FontSize="10" Foreground="#9BA5B8" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid AutomationProperties.AccessibilityView="Raw">
                                            <TextBlock x:Name="RfScaleHigh" Text="+FS" Style="{StaticResource StudioMonoTextStyle}" FontSize="9"
                                                       Foreground="#9BA5B8" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                            <TextBlock x:Name="RfScaleMiddle" Text="0" Style="{StaticResource StudioMonoTextStyle}" FontSize="9"
                                                       Foreground="#9BA5B8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock x:Name="RfScaleLow" Text="−FS" Style="{StaticResource StudioMonoTextStyle}" FontSize="9"
                                                       Foreground="#9BA5B8" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <Viewbox Grid.Column="1" Stretch="Fill">
                                            <Canvas Width="256" Height="100">
                                                <Line X1="0" X2="256" Y1="25" Y2="25" Stroke="#26FFFFFF" StrokeThickness="0.4" />
                                                <Line x:Name="RfReference" X1="0" X2="256" Y1="50" Y2="50" Stroke="#4DFFFFFF" StrokeThickness="0.6" />
                                                <Line X1="0" X2="256" Y1="75" Y2="75" Stroke="#26FFFFFF" StrokeThickness="0.4" />
                                                <Path x:Name="RfFftGrid" Visibility="Collapsed" Stroke="#38FFFFFF" StrokeThickness="0.4"
                                                      Data="M32,0 V100 M64,0 V100 M96,0 V100 M128,0 V100 M160,0 V100 M192,0 V100 M224,0 V100" />
                                                <Polyline x:Name="RfTraceA" Stroke="{ThemeResource StudioSignalLockBrush}" StrokeThickness="0.85" StrokeLineJoin="Round" />
                                                <Polyline x:Name="RfTraceB" Stroke="{ThemeResource StudioInfoBrush}" StrokeThickness="0.85" StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Unified Modular Instruments Host (Luma/Parade + Vector/Spectrum/Events) -->
                        <Grid x:Name="InstrumentsHost" Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="InstrumentCol0" Width="56*" />
                                <ColumnDefinition x:Name="InstrumentCol1" Width="44*" />
                            </Grid.ColumnDefinitions>

                            <!-- Luma Waveform / RGB Parade Card -->
                            <Border x:Name="LumaCard" Grid.Column="0" Style="{StaticResource StudioInstrumentCardStyle}"
                                    Padding="10,8">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock x:Name="LumaHeading" Text="Luma waveform" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                                            <TextBlock x:Name="LumaScaleDescription" Text="Y′ · Waiting" FontSize="12"
                                                       Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="ScopeStatus" FontSize="11"
                                                       Foreground="{ThemeResource StudioTextMutedBrush}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{ThemeResource StudioSegmentTrackBrush}"
                                                    BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1"
                                                    CornerRadius="3" Padding="1">
                                                <StackPanel Orientation="Horizontal" Spacing="1">
                                                    <Button x:Name="ScopeLumaBtn" Height="22" Padding="6,0" FontSize="11"
                                                            CornerRadius="2" Style="{StaticResource StudioSegmentButtonStyle}"
                                                            Tag="Luma" Click="ScopeWaveformMode_Click" Content="Y′" />
                                                    <Button x:Name="ScopeParadeBtn" Height="22" Padding="6,0" FontSize="11"
                                                            CornerRadius="2" Style="{StaticResource StudioSegmentButtonStyle}"
                                                            Tag="RgbParade" Click="ScopeWaveformMode_Click" Content="RGB" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{ThemeResource StudioSegmentTrackBrush}"
                                                    BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1"
                                                    CornerRadius="3" Padding="1">
                                                <StackPanel Orientation="Horizontal" Spacing="1">
                                                    <Button x:Name="ScopeScaleCodeBtn" Height="22" Padding="6,0" FontSize="11"
                                                            CornerRadius="2" Style="{StaticResource StudioSegmentButtonStyle}"
                                                            Tag="Code" Click="ScopeLumaScale_Click" />
                                                    <Button x:Name="ScopeScaleIreBtn" Height="22" Padding="6,0" FontSize="11"
                                                            CornerRadius="2" Style="{StaticResource StudioSegmentButtonStyle}"
                                                            Tag="Ire" Click="ScopeLumaScale_Click" Content="IRE" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Background="{ThemeResource StudioStageCanvasBrush}"
                                            BorderBrush="{ThemeResource StudioMonitorBezelBrush}" BorderThickness="1"
                                            CornerRadius="2" Padding="6,5">
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="LumaAxisColumn" Width="34" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid x:Name="LumaAxis" SizeChanged="LumaAxis_SizeChanged" AutomationProperties.AccessibilityView="Raw">
                                                <TextBlock x:Name="LumaScaleTop" Text="—" Style="{StaticResource StudioMonoTextStyle}"
                                                           FontSize="10" Height="12" Foreground="#9BA5B8" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock x:Name="LumaScaleHigh" Text="—" Style="{StaticResource StudioMonoTextStyle}"
                                                           FontSize="10" Height="12" Foreground="#9BA5B8" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock x:Name="LumaScaleMid" Text="—" Style="{StaticResource StudioMonoTextStyle}"
                                                           FontSize="10" Height="12" Foreground="#9BA5B8" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock x:Name="LumaScaleLow" Text="—" Style="{StaticResource StudioMonoTextStyle}"
                                                           FontSize="10" Height="12" Foreground="#9BA5B8" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock x:Name="LumaScaleZero" Text="0" Style="{StaticResource StudioMonoTextStyle}"
                                                           FontSize="10" Height="12" Foreground="#9BA5B8" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                <TextBlock x:Name="LumaCodeWhite" Style="{StaticResource StudioMonoTextStyle}"
                                                           FontSize="10" Height="12" Foreground="#E8BA67" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
                                                <TextBlock x:Name="LumaCodeBlack" Style="{StaticResource StudioMonoTextStyle}"
                                                           FontSize="10" Height="12" Foreground="#E8BA67" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
                                                <TextBlock x:Name="LumaScaleSetup" Text="7.5" Style="{StaticResource StudioMonoTextStyle}"
                                                           FontSize="10" Height="12" Foreground="#E8BA67" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" />
                                            </Grid>
                                            <Image x:Name="WaveformPlot" Grid.Column="1" Stretch="Fill"
                                                   AutomationProperties.Name="Luma waveform" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Secondary Instrument Host (Vectorscope / Spectrum / Events) -->
                            <Border x:Name="SecondaryInstrumentCard" Grid.Column="1"
                                    Style="{StaticResource StudioInstrumentCardStyle}" Padding="10,8">
                                <Grid RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock x:Name="SecondaryInstrumentTitle" Text="Vectorscope"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                                            <ComboBox x:Name="RfSpectrumSource" Visibility="Collapsed" AutomationProperties.Name="RF / PCM"
                                                      SelectedIndex="0" SelectionChanged="RfSpectrumSource_Changed">
                                                <x:String>RF</x:String><x:String>PCM</x:String>
                                            </ComboBox>
                                            <TextBlock x:Name="SecondaryInstrumentSubtitle" FontSize="12"
                                                       Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <Border x:Name="SplitRightSwitcher" Grid.Column="1"
                                                Background="{ThemeResource StudioSegmentTrackBrush}"
                                                BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1"
                                                CornerRadius="3" Padding="2">
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <Button x:Name="SplitVectorBtn" Height="24" Padding="8,0" FontSize="12"
                                                        CornerRadius="2" Style="{StaticResource StudioSegmentButtonStyle}"
                                                        Tag="Vector" Click="SplitSecondary_Click" />
                                                <Button x:Name="SplitSpectrumBtn" Height="24" Padding="8,0" FontSize="12"
                                                        CornerRadius="2" Style="{StaticResource StudioSegmentButtonStyle}"
                                                        Tag="Spectrum" Click="SplitSecondary_Click" />
                                                <Button x:Name="SplitEventsBtn" Height="24" Padding="8,0" FontSize="12"
                                                        CornerRadius="2" Style="{StaticResource StudioSegmentButtonStyle}"
                                                        Tag="Events" Click="SplitSecondary_Click" />
                                            </StackPanel>
                                        </Border>

                                        <StackPanel x:Name="EventsToolbar" Grid.Column="1" Orientation="Horizontal"
                                                    Spacing="4" Visibility="Collapsed" VerticalAlignment="Center">
                                            <Button x:Name="EventsFilterAllBtn" Height="24" Padding="7,0" FontSize="11"
                                                    CornerRadius="3" Style="{StaticResource StudioSegmentButtonStyle}"
                                                    Tag="All" Click="EventsFilter_Click" />
                                            <Button x:Name="EventsFilterDropsBtn" Height="24" Padding="7,0" FontSize="11"
                                                    CornerRadius="3" Style="{StaticResource StudioSegmentButtonStyle}"
                                                    Tag="Drops" Click="EventsFilter_Click" />
                                            <Button x:Name="EventsFilterSignalBtn" Height="24" Padding="7,0" FontSize="11"
                                                    CornerRadius="3" Style="{StaticResource StudioSegmentButtonStyle}"
                                                    Tag="Signal" Click="EventsFilter_Click" />
                                            <Button x:Name="CopyEventsButton" Width="24" Height="24" Padding="0"
                                                    CornerRadius="3" Style="{StaticResource SubtleButtonStyle}"
                                                    Click="CopyEvents_Click">
                                                <FontIcon x:Name="CopyEventsIcon" Glyph="&#xE8C8;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Border x:Name="VectorBody" Grid.Row="1"
                                            Background="{ThemeResource StudioStageCanvasBrush}"
                                            BorderBrush="{ThemeResource StudioMonitorBezelBrush}" BorderThickness="1"
                                            CornerRadius="2" Padding="6">
                                        <Grid>
                                            <Image x:Name="VectorPlot" Stretch="Uniform"
                                                   AutomationProperties.Name="Chroma vectorscope plot" />
                                            <TextBlock x:Name="VectorAxes" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                       Margin="4,0" FontSize="10" Foreground="#7A869A"
                                                       IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>

                                    <Grid x:Name="SpectrumBody" Grid.Row="1" Visibility="Collapsed" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="SpectrumLevelColumn" Width="36" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.ColumnSpan="2" Background="{ThemeResource StudioStageCanvasBrush}"
                                                BorderBrush="{ThemeResource StudioMonitorBezelBrush}" BorderThickness="1"
                                                CornerRadius="2" />
                                        <Canvas x:Name="SpectrumLevelAxis" Margin="4,8,4,8" IsHitTestVisible="False" />
                                        <Grid x:Name="SpectrumPlot" Grid.Column="1" Margin="0,8,8,8"
                                              SizeChanged="SpectrumPlot_SizeChanged"
                                              AutomationProperties.Name="Stereo frequency spectrum">
                                            <Canvas x:Name="SpectrumGridLines" IsHitTestVisible="False" />
                                            <Polygon x:Name="SpectrumFill" Fill="{StaticResource StudioSpectrumFillBrush}"
                                                     IsHitTestVisible="False" />
                                            <Polyline x:Name="SpectrumPeakHold" Stroke="#66A7F3D0" StrokeThickness="1"
                                                      StrokeLineJoin="Round" IsHitTestVisible="False" />
                                            <Polyline x:Name="SpectrumTrace" Stroke="#34D399" StrokeThickness="1.75"
                                                      StrokeLineJoin="Round" IsHitTestVisible="False" />
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="dBFS" HorizontalAlignment="Right" Margin="0,0,4,0"
                                                   FontSize="10" Foreground="{ThemeResource StudioTextMutedBrush}" />
                                        <Grid Grid.Row="1" Grid.Column="1" Margin="2,0,8,0">
                                            <TextBlock x:Name="SpectrumMinFrequency" Text="0 Hz" Style="{StaticResource StudioMonoTextStyle}"
                                                       FontSize="10" Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                            <TextBlock x:Name="SpectrumMidFrequency" Text="—" HorizontalAlignment="Center"
                                                       Style="{StaticResource StudioMonoTextStyle}" FontSize="10"
                                                       Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                            <TextBlock x:Name="SpectrumMaxFrequency" Text="—" HorizontalAlignment="Right"
                                                       Style="{StaticResource StudioMonoTextStyle}" FontSize="10"
                                                       Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                        </Grid>
                                    </Grid>

                                    <Grid x:Name="EventsBody" Grid.Row="1" Visibility="Collapsed">
                                        <Border Background="{ThemeResource StudioEventsSurfaceBrush}"
                                                BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1"
                                                CornerRadius="3" Padding="6">
                                            <Grid>
                                                <StackPanel x:Name="EventsEmptyState" HorizontalAlignment="Center"
                                                            VerticalAlignment="Center" Spacing="6">
                                                    <FontIcon Glyph="&#xE930;" FontSize="18"
                                                              Foreground="{ThemeResource StudioTextMutedBrush}" />
                                                    <TextBlock x:Name="EventsSummary" Text="No signal or timestamp events."
                                                               FontSize="12" Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                                               TextAlignment="Center" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <ListView x:Name="EventList" SelectionMode="None" Visibility="Collapsed"
                                                          AutomationProperties.Name="Capture event timeline">
                                                    <ListView.ItemContainerStyle>
                                                        <Style TargetType="ListViewItem">
                                                            <Setter Property="MinHeight" Value="28" />
                                                            <Setter Property="Padding" Value="6,3" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        </Style>
                                                    </ListView.ItemContainerStyle>
                                                    <ListView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnSpacing="10">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Rectangle Width="6" Height="6" RadiusX="1" RadiusY="1"
                                                                           Fill="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                                <Border Grid.Column="1" Background="{ThemeResource StudioEventTimeBgBrush}"
                                                                        CornerRadius="2" Padding="6,1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding TimeLabel}"
                                                                               FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                                               Foreground="{ThemeResource StudioEventTimeTextBrush}" />
                                                                </Border>
                                                                <TextBlock Grid.Column="2" Text="{Binding Description}"
                                                                           FontSize="12" Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                                                           TextWrapping="Wrap" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListView.ItemTemplate>
                                                </ListView>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                        </Grid>
                    </Grid>

                    <!-- Pluggable Slot: Non-DeckLink / Planned Backend Stage -->
                    <ContentPresenter x:Name="StageSlot" Grid.Row="1" Visibility="Collapsed" />
                    <controls:BroadcastMeterControl x:Name="StereoMeter" Grid.Column="1" Grid.RowSpan="3" />
                </Grid>

                <!-- Overlay Scrim when Inspector is floating on narrow windows -->
                <Border x:Name="InspectorScrim" Grid.ColumnSpan="2" Margin="-10,-8"
                        Background="{ThemeResource StudioOverlayScrimBrush}" Visibility="Collapsed"
                        Tapped="InspectorScrim_Tapped" />

                <!-- Right Collapsible / Pinnable Modular Inspector Drawer -->
                <Border x:Name="InspectorPanel" Grid.Column="1" Width="314"
                        Style="{StaticResource StudioInstrumentCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="12,9,8,9" BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9E9;" FontSize="13" Foreground="{ThemeResource StudioAccentBrush}" />
                                <TextBlock x:Name="InputHeading" Text="Capture" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ThemeResource StudioTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                <Button x:Name="PinInspectorButton" Style="{StaticResource StudioIconButtonStyle}"
                                        Width="26" Height="26" Click="PinInspectorButton_Click">
                                    <FontIcon x:Name="PinInspectorIcon" Glyph="&#xE718;" FontSize="12" />
                                </Button>
                                <Button x:Name="CloseInspectorButton" Style="{StaticResource StudioIconButtonStyle}"
                                        Width="26" Height="26" Click="CloseInspectorButton_Click">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ScrollView x:Name="InspectorScroller" Grid.Row="1" Background="Transparent"
                                    ContentOrientation="Vertical" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden"
                                    HorizontalContentAlignment="Stretch">
                            <StackPanel Padding="10" Spacing="8">
                                <Border x:Name="InspectorNotice" Visibility="Collapsed" CornerRadius="3"
                                        Padding="10,8" BorderThickness="1"
                                        Background="{ThemeResource StudioInfoSoftBrush}"
                                        BorderBrush="{ThemeResource StudioInfoBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="InspectorNoticeIcon" Glyph="&#xE946;" FontSize="13"
                                                  Foreground="{ThemeResource StudioInfoBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                        <TextBlock x:Name="InspectorNoticeText" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <!-- Pluggable Slot: Active Backend Configuration Cards (DeckLink / DirectShow / FireWire / TestSignal / Planned) -->
                                <ContentPresenter x:Name="InspectorSlot" />

                                <!-- Shared Output, Tape Label & Storage Capacity Card -->
                                <Border x:Name="OutputStorageCard" Style="{StaticResource StudioInspectorCardStyle}">
                                    <StackPanel Spacing="9">
                                        <Grid>
                                            <TextBlock x:Name="OutputHeading" Text="OUTPUT &amp; STORAGE"
                                                       Style="{StaticResource StudioSectionHeadingStyle}" VerticalAlignment="Center" />
                                            <Button x:Name="BrowseButton" HorizontalAlignment="Right"
                                                    Style="{StaticResource SubtleButtonStyle}" Height="24" Padding="7,0"
                                                    CornerRadius="3" Click="BrowseButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon Glyph="&#xE838;" FontSize="11" />
                                                    <TextBlock x:Name="BrowseLabel" FontSize="11" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <TextBox x:Name="OutputPath" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                                                 CornerRadius="3" FontSize="13" TextChanged="OutputPath_TextChanged" />

                                        <StackPanel x:Name="RecordingEncodingPanel" Spacing="8" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock x:Name="RecordingOutputLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                                                <ComboBox x:Name="RecordingOutputPicker" CornerRadius="3" HorizontalAlignment="Stretch"
                                                          DisplayMemberPath="Label" SelectionChanged="RecordingOutputChanged" />
                                            </StackPanel>
                                            <StackPanel x:Name="RecordingEncoderParameters" Spacing="8" Visibility="Collapsed">
                                                <StackPanel Spacing="5">
                                                    <TextBlock x:Name="RecordingBitrateLabel" Style="{StaticResource StudioFieldLabelStyle}" Margin="0" />
                                                    <TextBox x:Name="RecordingBitrateBox" MaxLength="7" CornerRadius="3"
                                                             FontSize="13" InputScope="Number" TextChanged="RecordingOutputChanged" />
                                                    <StackPanel x:Name="BitratePresetPanel" Orientation="Horizontal" Spacing="4">
                                                        <Button x:Name="BitratePresetAutoBtn" Style="{StaticResource SubtleButtonStyle}"
                                                                Height="22" Padding="7,0" CornerRadius="2" FontSize="11"
                                                                Tag="" Click="BitratePreset_Click" />
                                                        <Button x:Name="BitratePreset15Btn" Style="{StaticResource SubtleButtonStyle}"
                                                                Height="22" Padding="7,0" CornerRadius="2" FontSize="11"
                                                                Content="15M" Tag="15000" Click="BitratePreset_Click" />
                                                        <Button x:Name="BitratePreset25Btn" Style="{StaticResource SubtleButtonStyle}"
                                                                Height="22" Padding="7,0" CornerRadius="2" FontSize="11"
                                                                Content="25M" Tag="25000" Click="BitratePreset_Click" />
                                                        <Button x:Name="BitratePreset50Btn" Style="{StaticResource SubtleButtonStyle}"
                                                                Height="22" Padding="7,0" CornerRadius="2" FontSize="11"
                                                                Content="50M" Tag="50000" Click="BitratePreset_Click" />
                                                    </StackPanel>
                                                    <Border x:Name="RecordingBitrateErrorBanner" Visibility="Collapsed" CornerRadius="3" Padding="8,5"
                                                            BorderThickness="1"
                                                            Background="{ThemeResource StudioDangerSoftBrush}"
                                                            BorderBrush="{ThemeResource StudioDangerBrush}">
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE783;" FontSize="11" Foreground="{ThemeResource StudioDangerBrush}"
                                                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                                                            <TextBlock x:Name="RecordingBitrateErrorText" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                                                                       Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock x:Name="RecordingLevelLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                                                    <TextBox x:Name="RecordingLevelBox" MaxLength="8" CornerRadius="3"
                                                             FontSize="13" TextChanged="RecordingOutputChanged" />
                                                </StackPanel>
                                                <CheckBox x:Name="RecordingDeinterlaceBox" MinWidth="0"
                                                          Checked="RecordingOutputChanged" Unchecked="RecordingOutputChanged" />
                                                <Border x:Name="RecordingInterlacedBanner" Visibility="Collapsed" CornerRadius="3" Padding="8,6"
                                                        BorderThickness="1"
                                                        Background="{ThemeResource StudioCautionSoftBrush}"
                                                        BorderBrush="{ThemeResource StudioCautionBrush}">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnSpacing="6">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="{ThemeResource StudioCautionBrush}"
                                                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                                                            <TextBlock x:Name="RecordingInterlacedWarningText" Grid.Column="1" FontSize="11" TextWrapping="Wrap"
                                                                       Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                                                        </Grid>
                                                        <Button x:Name="EnableDeinterlaceQuickButton" Style="{StaticResource SubtleButtonStyle}"
                                                                Height="24" Padding="8,0" CornerRadius="3" FontSize="11"
                                                                HorizontalAlignment="Left" Click="EnableDeinterlaceQuick_Click" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock x:Name="RecordingEncodingHint" TextWrapping="Wrap" FontSize="11"
                                                       Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock x:Name="RecordingLabelHeading" Style="{StaticResource StudioFieldLabelStyle}" />
                                            <TextBox x:Name="RecordingLabelBox" IsSpellCheckEnabled="False"
                                                     IsTextPredictionEnabled="False" MaxLength="48"
                                                     CornerRadius="3" FontSize="13" TextChanged="RecordingLabelBox_TextChanged" />
                                            <TextBlock x:Name="RecordingFilenamePreview" Margin="0,4,0,0"
                                                       Style="{StaticResource StudioMonoTextStyle}" FontSize="10"
                                                       Foreground="{ThemeResource StudioTextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Spacing="5">
                                            <ProgressBar x:Name="InspectorStorageBar" Minimum="0" Maximum="100" Value="0"
                                                         Height="4" CornerRadius="1" Visibility="Collapsed" />
                                            <TextBlock x:Name="InspectorStorageStatus" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                            <TextBlock x:Name="OutputHelpText" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource StudioTextMutedBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Slot 5: Extensible Host Slot for Future Transport Control (ITransportController) -->
                                <ContentPresenter x:Name="TransportControlSlot" Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollView>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. Extracted Multi-Format QC Center View (MOV + TS/TS192/M2T + Session History) -->
            <views:QcCenterView x:Name="QcCenterPage" Visibility="Collapsed" />

            <!-- 3. Extracted Refined App Settings View -->
            <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        </Grid>

        <!-- Refined Single-Row Broadcast Transport & Dynamic Telemetry Footer -->
        <Grid x:Name="CaptureFooter" Grid.Row="2" Background="{ThemeResource StudioPanelBrush}"
              BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="0,1,0,0">
            <Grid x:Name="RecordingSweepTrack" Height="2" VerticalAlignment="Top" Visibility="Collapsed"
                  Background="{ThemeResource StudioRecSoftBrush}" IsHitTestVisible="False"
                  SizeChanged="RecordingSweepTrack_SizeChanged">
                <Border x:Name="RecordingSweepBeam" Width="220" Height="2" HorizontalAlignment="Left"
                        Background="{StaticResource StudioRecSweepBrush}" />
            </Grid>

            <Grid x:Name="FooterLayout" Padding="12,8" ColumnSpacing="10" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="FooterCenterColumn" Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left Cluster: Preview + Broadcast Crimson Record + Animated Reel & Timecode -->
                <StackPanel x:Name="FooterLeftCluster" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Style="{StaticResource StudioTransportPrimaryButtonStyle}"
                            IsEnabled="False" Click="StartButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="PreviewActionIcon" Glyph="&#xE768;" FontSize="13" />
                            <TextBlock x:Name="PreviewActionLabel" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RecordButton" Style="{StaticResource StudioRecordIdleButtonStyle}"
                            IsEnabled="False" Click="RecordButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="RecordActionDot" Width="8" Height="8"
                                     Fill="{ThemeResource StudioRecBrush}" VerticalAlignment="Center" />
                            <FontIcon x:Name="RecordActionStopIcon" Glyph="&#xE71A;" FontSize="12"
                                      Visibility="Collapsed" VerticalAlignment="Center" />
                            <ProgressRing x:Name="RecordActionSpinner" Width="13" Height="13"
                                          IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                            <TextBlock x:Name="RecordActionLabel" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border x:Name="FooterFinalizingPill" Visibility="Collapsed" CornerRadius="4" Padding="9,5"
                            Background="{ThemeResource StudioInfoSoftBrush}"
                            BorderBrush="{ThemeResource StudioInfoBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <ProgressRing x:Name="FooterFinalizingSpinner" Width="12" Height="12" IsActive="False" />
                            <TextBlock x:Name="FooterFinalizingText" FontSize="12" FontWeight="SemiBold"
                                       MaxWidth="210" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource StudioTextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="RecordingClock" Visibility="Collapsed" CornerRadius="4" Padding="10,5"
                            Background="{ThemeResource StudioRecSoftBrush}"
                            BorderBrush="{ThemeResource StudioRecBorderBrush}" BorderThickness="1"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse x:Name="RecordingIndicator" Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{ThemeResource StudioRecBrush}" />
                            <Grid x:Name="RecordingReelRotor" Width="15" Height="15" VerticalAlignment="Center">
                                <Ellipse Stroke="{ThemeResource StudioRecBrush}" StrokeThickness="1.5" />
                                <Rectangle Width="2" Height="13" Fill="{ThemeResource StudioRecBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Rectangle Width="13" Height="2" Fill="{ThemeResource StudioRecBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="5" Height="5" Fill="{ThemeResource StudioPanelBrush}"
                                         Stroke="{ThemeResource StudioRecBrush}" StrokeThickness="1" />
                            </Grid>
                            <TextBlock x:Name="RecordingElapsed" Text="00:00:00"
                                       Style="{StaticResource StudioTimecodeTextStyle}"
                                       Foreground="{ThemeResource StudioTextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center Cluster: Dynamic Backend-Driven Telemetry Strip -->
                <StackPanel x:Name="FooterTelemetry" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="RfMeasureButton" Visibility="Collapsed" Padding="8,4" CornerRadius="3"
                            Style="{StaticResource SubtleButtonStyle}" Background="{ThemeResource StudioCardBrush}"
                            BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="RfMeasureLabel" FontSize="12" Foreground="{ThemeResource StudioTextSecondaryBrush}"/>
                            <TextBlock x:Name="RfPeakSpan" Style="{StaticResource StudioMonoTextStyle}" FontSize="12" FontWeight="SemiBold"/>
                            <FontIcon Glyph="&#xE70E;" FontSize="9"/>
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Top" x:Name="RfMeasureFlyout" Opened="RfMeasureFlyout_Opened">
                                <StackPanel Spacing="8" Width="260">
                                    <Grid ColumnSpacing="12" RowSpacing="4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="RfMeasureHeading" Style="{StaticResource StudioSectionHeadingStyle}"/>
                                        <TextBlock x:Name="RfChannelA" Grid.Column="1" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="RfChannelB" Grid.Column="2" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Text="Min" Foreground="{ThemeResource StudioTextSecondaryBrush}"/>
                                    <TextBlock x:Name="RfMinA" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource StudioMonoTextStyle}"/>
                                    <TextBlock x:Name="RfMinB" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource StudioMonoTextStyle}"/>
                                    <TextBlock Grid.Row="2" Text="Max" Foreground="{ThemeResource StudioTextSecondaryBrush}"/>
                                    <TextBlock x:Name="RfMaxA" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource StudioMonoTextStyle}"/>
                                    <TextBlock x:Name="RfMaxB" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource StudioMonoTextStyle}"/>
                                    <TextBlock Grid.Row="3" Text="P-P" Foreground="{ThemeResource StudioTextSecondaryBrush}"/>
                                    <TextBlock x:Name="RfPpA" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource StudioMonoTextStyle}"/>
                                    <TextBlock x:Name="RfPpB" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource StudioMonoTextStyle}"/>
                                    <TextBlock Grid.Row="4" Text="RMS" Foreground="{ThemeResource StudioTextSecondaryBrush}"/>
                                    <TextBlock x:Name="RfRmsA" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource StudioMonoTextStyle}"/>
                                    <TextBlock x:Name="RfRmsB" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource StudioMonoTextStyle}"/>
                                    <TextBlock Grid.Row="5" Text="CLIP" Foreground="{ThemeResource StudioTextSecondaryBrush}"/>
                                    <TextBlock x:Name="RfClipsA" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource StudioMonoTextStyle}"/>
                                    <TextBlock x:Name="RfClipsB" Grid.Row="5" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource StudioMonoTextStyle}"/>
                                    </Grid>
                                    <Border Height="1" Background="{ThemeResource StudioHairlineBrush}"/>
                                    <TextBlock x:Name="RfReading" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="RfFile" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource StudioTextSecondaryBrush}"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <ItemsControl x:Name="TelemetryStrip" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ChipBackground}" BorderBrush="{Binding ChipBorder}"
                                        BorderThickness="1" CornerRadius="3" Padding="8,4"
                                        ToolTipService.ToolTip="{Binding Tooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Label}" FontSize="12"
                                                   Foreground="{ThemeResource StudioTextSecondaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Value}" Style="{StaticResource StudioMonoTextStyle}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding ValueForeground}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Right Cluster: Storage + Live QC Activity/Result + Status Flyout -->
                <StackPanel x:Name="FooterRightCluster" Grid.Column="2" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="FooterStorageButton" Style="{StaticResource SubtleButtonStyle}"
                            Height="30" Padding="8,0" CornerRadius="3"
                            Background="{ThemeResource StudioCardBrush}"
                            BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1"
                            Click="OpenInspectorFromFooter_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xEDA2;" FontSize="12" Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                            <TextBlock x:Name="StorageStatus" FontSize="12" MaxWidth="175"
                                       Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <ProgressBar x:Name="FooterStorageBar" Width="32" Height="4" Minimum="0" Maximum="100" Value="0"
                                         CornerRadius="1" Visibility="Collapsed" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border x:Name="FooterQcActivePill" Visibility="Collapsed" CornerRadius="3" Padding="8,0" Height="30"
                            Background="{ThemeResource StudioInfoSoftBrush}"
                            BorderBrush="{ThemeResource StudioInfoBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ProgressRing Width="13" Height="13" IsActive="True" />
                            <Button Style="{StaticResource SubtleButtonStyle}" Padding="2,0" Height="22"
                                    Click="QcModeButton_Click">
                                <TextBlock x:Name="FooterQcStageText" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                            </Button>
                            <Button x:Name="CancelQcButton" Style="{StaticResource SubtleButtonStyle}"
                                    Width="22" Height="22" Padding="0" CornerRadius="2" Click="CancelQcButton_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Button x:Name="QcResultsButton" Visibility="Collapsed" Height="30" Padding="9,0" CornerRadius="3"
                            Style="{StaticResource SubtleButtonStyle}"
                            BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1"
                            Click="QcResultsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle x:Name="QcResultsDot" Width="6" Height="6" RadiusX="1" RadiusY="1"
                                       Fill="{ThemeResource StudioSignalLockBrush}" />
                            <TextBlock x:Name="QcResultsLabel" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="StatusDetailsButton" Height="30" Padding="9,0" CornerRadius="3"
                            Style="{StaticResource SubtleButtonStyle}"
                            Background="{ThemeResource StudioCardBrush}"
                            BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Rectangle x:Name="StatusDot" Width="6" Height="6" RadiusX="1" RadiusY="1"
                                       Fill="{ThemeResource StudioInfoBrush}" />
                            <TextBlock x:Name="StatusTitleText" FontSize="13" MaxWidth="170"
                                       Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                            <FontIcon Glyph="&#xE70E;" FontSize="9" Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <StackPanel Spacing="8" MaxWidth="380">
                                    <InfoBar x:Name="SignalStatus" Title="Idle" IsOpen="True" IsClosable="False"
                                             Message="Select a video and audio source to start." />
                                    <TextBlock x:Name="StatusFileName" Visibility="Collapsed" TextWrapping="Wrap"
                                               Style="{StaticResource StudioMonoTextStyle}" FontSize="11"
                                               Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                    <TextBlock x:Name="LivePreviewStatus" Visibility="Collapsed" TextWrapping="Wrap"
                                               FontSize="12" Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
