<UserControl x:Class="CaptureRack.App.Controls.RfPeakMeter"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="{ThemeResource StudioCardBrush}" BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
  <Grid RowSpacing="3" Width="44">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="Channel" Text="ADC" HorizontalAlignment="Center"/>
   <Button x:Name="High" Grid.Row="1" Content="+CLIP" FontSize="10" AutomationProperties.Name="Positive CLIP" Click="ClearHigh" MinWidth="0" Padding="0" HorizontalAlignment="Stretch"/>
   <Grid Grid.Row="2">
   <Viewbox Stretch="Fill" Margin="12,0,4,0">
    <Canvas Width="20" Height="200" Background="{ThemeResource StudioStageCanvasBrush}">
     <Rectangle x:Name="Positive" Width="20" Fill="{ThemeResource StudioSignalLockBrush}"/>
     <Rectangle x:Name="Negative" Width="20" Canvas.Top="100" Fill="{ThemeResource StudioInfoBrush}"/>
     <Rectangle x:Name="HoldHigh" Width="20" Height="1.5" Fill="{ThemeResource StudioTextPrimaryBrush}"/>
     <Rectangle x:Name="HoldLow" Width="20" Height="1.5" Fill="{ThemeResource StudioTextPrimaryBrush}"/>
    </Canvas>
   </Viewbox>
   <Border Height="4" Margin="10,0,0,0" Background="{ThemeResource StudioStageCanvasBrush}" VerticalAlignment="Center"/>
   <Border Height="2" Margin="10,0,0,0" Background="{ThemeResource StudioTextPrimaryBrush}" VerticalAlignment="Center"/>
   <TextBlock Text="0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{ThemeResource StudioTextPrimaryBrush}"/>
   </Grid>
   <Button x:Name="Low" Grid.Row="3" Content="−CLIP" FontSize="10" AutomationProperties.Name="Negative CLIP" Click="ClearLow" MinWidth="0" Padding="0" HorizontalAlignment="Stretch"/>
  </Grid>
 </Border>
</UserControl>
