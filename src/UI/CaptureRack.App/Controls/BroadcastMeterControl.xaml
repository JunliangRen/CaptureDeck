<UserControl
    x:Class="CaptureRack.App.Controls.BroadcastMeterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ClipLatchButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource StudioMeterTrackBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource StudioHairlineBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.86" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.72" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Width="86" Style="{StaticResource StudioInstrumentCardStyle}" Padding="8,10">
        <Grid x:Name="StereoMeterGrid" RowSpacing="6" AutomationProperties.Name="Stereo audio peak meters">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock x:Name="StereoHeading" Text="AUDIO" Style="{StaticResource StudioSectionHeadingStyle}"
                           HorizontalAlignment="Left" />
                <TextBlock Text="dBFS" FontSize="10" Foreground="{ThemeResource StudioTextMutedBrush}"
                           HorizontalAlignment="Right" />
            </Grid>

            <!-- Clickable CLIP Latch Indicators (click to reset monitoring latch) -->
            <Grid Grid.Row="1" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>
                <Button x:Name="LeftClipButton" Style="{StaticResource ClipLatchButtonStyle}"
                        Click="LeftClipButton_Click">
                    <TextBlock x:Name="LeftChannel" Text="L" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                </Button>
                <Button x:Name="RightClipButton" Grid.Column="1" Style="{StaticResource ClipLatchButtonStyle}"
                        Click="RightClipButton_Click">
                    <TextBlock x:Name="RightChannel" Text="R" FontSize="10" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- Vertical Ballistic Gradient Bars + Peak Hold + dB Scale -->
            <Grid Grid.Row="2" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>

                <Grid x:Name="LeftMeterRail" Width="12" HorizontalAlignment="Center"
                      SizeChanged="MeterRail_SizeChanged">
                    <Border CornerRadius="1" Background="{ThemeResource StudioMeterTrackBrush}"
                            BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1" />
                    <Border CornerRadius="1" Background="{StaticResource StudioMeterFillBrush}"
                            Margin="1" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="LeftMeterFill" ScaleY="0" />
                        </Border.RenderTransform>
                    </Border>
                    <Border x:Name="LeftPeakHoldBar" Height="2" VerticalAlignment="Bottom"
                            Margin="1,0" CornerRadius="0" Opacity="0"
                            Background="{ThemeResource StudioMeterPeakBrush}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LeftPeakHoldOffset" Y="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <Grid x:Name="RightMeterRail" Grid.Column="1" Width="12" HorizontalAlignment="Center">
                    <Border CornerRadius="1" Background="{ThemeResource StudioMeterTrackBrush}"
                            BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1" />
                    <Border CornerRadius="1" Background="{StaticResource StudioMeterFillBrush}"
                            Margin="1" RenderTransformOrigin="0.5,1">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="RightMeterFill" ScaleY="0" />
                        </Border.RenderTransform>
                    </Border>
                    <Border x:Name="RightPeakHoldBar" Height="2" VerticalAlignment="Bottom"
                            Margin="1,0" CornerRadius="0" Opacity="0"
                            Background="{ThemeResource StudioMeterPeakBrush}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="RightPeakHoldOffset" Y="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <Grid Grid.Column="2" AutomationProperties.AccessibilityView="Raw">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="0" Style="{StaticResource StudioMonoTextStyle}" FontSize="9"
                               Foreground="{ThemeResource StudioTextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <TextBlock Grid.Row="1" Text="-12" Style="{StaticResource StudioMonoTextStyle}" FontSize="9"
                               Foreground="{ThemeResource StudioTextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,0,0" />
                    <TextBlock Grid.Row="2" Text="-24" Style="{StaticResource StudioMonoTextStyle}" FontSize="9"
                               Foreground="{ThemeResource StudioTextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,0,0" />
                    <TextBlock Grid.Row="3" Text="-36" Style="{StaticResource StudioMonoTextStyle}" FontSize="9"
                               Foreground="{ThemeResource StudioTextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,0,0" />
                    <TextBlock Grid.Row="4" Text="-48" Style="{StaticResource StudioMonoTextStyle}" FontSize="9"
                               Foreground="{ThemeResource StudioTextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,0,0" />
                    <TextBlock Grid.Row="4" Text="-60" Style="{StaticResource StudioMonoTextStyle}" FontSize="9"
                               Foreground="{ThemeResource StudioTextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>

            <Grid Grid.Row="3" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LeftLevel" Text="—" HorizontalAlignment="Center"
                           Style="{StaticResource StudioMonoTextStyle}" FontSize="10"
                           Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                <TextBlock x:Name="RightLevel" Grid.Column="1" Text="—" HorizontalAlignment="Center"
                           Style="{StaticResource StudioMonoTextStyle}" FontSize="10"
                           Foreground="{ThemeResource StudioTextPrimaryBrush}" />
            </Grid>

            <!-- Visual Stereo Phase Correlation Bar -->
            <StackPanel Grid.Row="4" Spacing="3">
                <Grid>
                    <TextBlock Text="-1" FontSize="9" Foreground="{ThemeResource StudioTextMutedBrush}" />
                    <TextBlock x:Name="PhaseLevel" Text="—" HorizontalAlignment="Center"
                               Style="{StaticResource StudioMonoTextStyle}" FontSize="10"
                               Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                    <TextBlock Text="+1" FontSize="9" Foreground="{ThemeResource StudioTextMutedBrush}"
                               HorizontalAlignment="Right" />
                </Grid>
                <Grid x:Name="PhaseBarRail" Height="6" SizeChanged="PhaseBarRail_SizeChanged">
                    <Border CornerRadius="1" Background="{ThemeResource StudioMeterTrackBrush}"
                            BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1" />
                    <Rectangle Width="1" Fill="{ThemeResource StudioTextMutedBrush}"
                               HorizontalAlignment="Center" Opacity="0.6" />
                    <Border x:Name="PhaseIndicatorFill" Height="4" CornerRadius="1"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{ThemeResource StudioSignalLockBrush}" Width="0" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
