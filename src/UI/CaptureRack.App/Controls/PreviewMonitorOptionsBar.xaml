<UserControl
    x:Class="CaptureRack.App.Controls.PreviewMonitorOptionsBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <!-- Preview-Only Display Options Popover -->
        <Button x:Name="MonitorOptionsButton" Style="{StaticResource SubtleButtonStyle}"
                Height="30" Padding="9,0" CornerRadius="3"
                Background="{ThemeResource StudioCardBrush}"
                BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE7F4;" FontSize="13" />
                <TextBlock x:Name="MonitorOptionsLabel" Text="Preview" FontSize="12" VerticalAlignment="Center" />
                <Rectangle x:Name="PreviewOverrideDot" Width="5" Height="5" RadiusX="1" RadiusY="1"
                           Fill="{ThemeResource StudioAccentBrush}" Visibility="Collapsed"
                           VerticalAlignment="Center" />
                <FontIcon Glyph="&#xE70D;" FontSize="9" Foreground="{ThemeResource StudioTextSecondaryBrush}" />
            </StackPanel>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                    <StackPanel Width="290" Spacing="10">
                        <Border Background="{ThemeResource StudioInfoSoftBrush}"
                                BorderBrush="{ThemeResource StudioInfoBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="8,6">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE946;" FontSize="12"
                                          Foreground="{ThemeResource StudioInfoBrush}"
                                          VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock x:Name="PreviewOnlyNoticeText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="DeinterlaceOptions">
                            <TextBlock x:Name="PreviewDeinterlaceLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                            <ComboBox x:Name="PreviewDeinterlacePicker" CornerRadius="3" HorizontalAlignment="Stretch"
                                      SelectionChanged="PreviewDeinterlacePicker_SelectionChanged">
                                <ComboBoxItem x:Name="DeinterlaceBobWeaveItem" Tag="BobWeave" Content="Bob-Weave ×1 (Adaptive)" />
                                <ComboBoxItem x:Name="DeinterlaceBobWeave2xItem" Tag="BobWeave2x" Content="Bob-Weave ×2 (Adaptive)" />
                                <ComboBoxItem x:Name="DeinterlaceOffItem" Tag="Off" Content="Original" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock x:Name="PreviewAspectLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                            <ComboBox x:Name="PreviewAspectPicker" CornerRadius="3" HorizontalAlignment="Stretch"
                                      SelectionChanged="PreviewAspectPicker_SelectionChanged">
                                <ComboBoxItem x:Name="AspectAutoItem" Tag="Auto" Content="Auto" />
                                <ComboBoxItem x:Name="Aspect4x3Item" Tag="Ratio4x3" Content="4:3" />
                                <ComboBoxItem x:Name="Aspect16x9Item" Tag="Ratio16x9" Content="16:9 (Anamorphic)" />
                                <ComboBoxItem x:Name="Aspect1x1Item" Tag="Square1x1" Content="1:1 (Square pixels)" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="MatrixOptions">
                            <TextBlock x:Name="PreviewMatrixLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                            <ComboBox x:Name="PreviewMatrixPicker" CornerRadius="3" HorizontalAlignment="Stretch"
                                      SelectionChanged="PreviewMatrixPicker_SelectionChanged">
                                <ComboBoxItem x:Name="MatrixAutoItem" Tag="Auto" Content="Auto (SD 601 / HD 709)" />
                                <ComboBoxItem x:Name="Matrix601Item" Tag="Bt601" Content="BT.601" />
                                <ComboBoxItem x:Name="Matrix709Item" Tag="Bt709" Content="BT.709" />
                            </ComboBox>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource StudioHairlineBrush}" Margin="0,2" />

                        <CheckBox x:Name="SafeAreaCheckBox" Click="SafeAreaCheckBox_Click" />
                        <CheckBox x:Name="Ntsc480GuideCheckBox" Click="Ntsc480GuideCheckBox_Click" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <!-- Preview-Only Local Audio Monitor Toggle + Volume -->
        <Border x:Name="AudioMonitorControlGroup" Background="{ThemeResource StudioCardBrush}"
                BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1"
                CornerRadius="3">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AudioMonitorMuteButton" Style="{StaticResource StudioIconButtonStyle}"
                        Width="30" Height="28" CornerRadius="2" Click="AudioMonitorMute_Click">
                    <FontIcon x:Name="AudioMonitorIcon" Glyph="&#xE74F;" FontSize="13" />
                </Button>
                <Border x:Name="AudioMonitorRouteBadge" Visibility="Collapsed" VerticalAlignment="Center"
                        CornerRadius="2" Padding="4,1" Margin="0,0,2,0"
                        Background="{ThemeResource StudioAccentSoftBrush}"
                        BorderBrush="{ThemeResource StudioAccentBrush}" BorderThickness="1">
                    <TextBlock x:Name="AudioMonitorRouteBadgeText" Style="{StaticResource StudioMonoTextStyle}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{ThemeResource StudioAccentBrush}" />
                </Border>
                <Button x:Name="AudioMonitorVolumeButton" Style="{StaticResource StudioIconButtonStyle}"
                        Width="20" Height="28" CornerRadius="2">
                    <FontIcon Glyph="&#xE70D;" FontSize="8" Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="244" Spacing="8">
                                <Grid>
                                    <TextBlock x:Name="AudioMonitorTitleText" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                                    <TextBlock x:Name="AudioMonitorVolumeText" HorizontalAlignment="Right"
                                               Style="{StaticResource StudioMonoTextStyle}" FontSize="12"
                                               Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="AudioMonitorVolumeSlider" Minimum="0" Maximum="100" Value="80"
                                        StepFrequency="1" ValueChanged="AudioMonitorVolumeSlider_ValueChanged" />
                                <StackPanel x:Name="AudioMonitorRouteSection" Spacing="4" Visibility="Collapsed">
                                    <TextBlock x:Name="AudioMonitorRouteLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                                    <ComboBox x:Name="AudioMonitorRoutePicker" CornerRadius="3" HorizontalAlignment="Stretch"
                                              SelectionChanged="AudioMonitorRoutePicker_SelectionChanged"
                                              DropDownClosed="AudioMonitorRoutePicker_DropDownClosed" />
                                </StackPanel>
                                <TextBlock x:Name="AudioMonitorNoticeText" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
