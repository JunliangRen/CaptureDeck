<UserControl
    x:Class="CaptureRack.App.Views.PlannedBackendStageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource StudioInstrumentCardStyle}" Padding="28">
        <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="4"
                        Background="{ThemeResource StudioPanelSecondaryBrush}"
                        BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1">
                    <FontIcon x:Name="BackendIcon" Glyph="&#xE714;" FontSize="22"
                              Foreground="{ThemeResource StudioAccentBrush}" />
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="BackendTitle" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                        <Border CornerRadius="2" Padding="7,2" VerticalAlignment="Center"
                                Background="{ThemeResource StudioInfoSoftBrush}"
                                BorderBrush="{ThemeResource StudioInfoBrush}" BorderThickness="1">
                            <TextBlock x:Name="StatusBadgeText" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource StudioInfoBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="BackendSubtitle" FontSize="13" TextWrapping="Wrap"
                               Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource StudioInspectorCardStyle}" Padding="14">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="CapabilitiesHeading" Style="{StaticResource StudioSectionHeadingStyle}" />
                    <ItemsRepeater x:Name="CapabilitiesList">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="150" MinItemHeight="28"
                                               MinColumnSpacing="6" MinRowSpacing="6"
                                               ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource StudioPanelSecondaryBrush}"
                                        BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1"
                                        CornerRadius="2" Padding="8,4">
                                    <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border x:Name="CliHintCard" Visibility="Collapsed" Style="{StaticResource StudioInspectorCardStyle}" Padding="14">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="CliHeading" Style="{StaticResource StudioSectionHeadingStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource StudioPanelSecondaryBrush}"
                                BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="10,7">
                            <TextBlock x:Name="CliCommandText" Style="{StaticResource StudioMonoTextStyle}"
                                       FontSize="12" IsTextSelectionEnabled="True"
                                       Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                        </Border>
                        <Button x:Name="CopyCliButton" Grid.Column="1" Style="{StaticResource StudioIconButtonStyle}"
                                Height="32" Width="32" Click="CopyCliButton_Click">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="PlannedNoticeText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource StudioTextSecondaryBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="SwitchToDeckLinkButton" Style="{StaticResource StudioTransportPrimaryButtonStyle}"
                        Click="SwitchToDeckLinkButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
