<UserControl
    x:Class="CaptureRack.App.Views.DirectShowCapabilitiesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="8">
        <!-- Card 1: DirectShow Source & Video Format -->
        <Border Style="{StaticResource StudioInspectorCardStyle}">
            <StackPanel Spacing="9">
                <Grid>
                    <TextBlock x:Name="DeviceSectionHeading" Text="DIRECTSHOW SOURCE"
                               Style="{StaticResource StudioSectionHeadingStyle}" VerticalAlignment="Center" />
                    <Button x:Name="RefreshButton" HorizontalAlignment="Right"
                            Style="{StaticResource SubtleButtonStyle}" Height="24" Padding="7,0"
                            CornerRadius="3" Click="RefreshClicked">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                            <TextBlock x:Name="RefreshLabel" FontSize="11" />
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel>
                    <TextBlock x:Name="DeviceLabel" Text="Device" Style="{StaticResource StudioFieldLabelStyle}" />
                    <ComboBox x:Name="DevicePicker" HorizontalAlignment="Stretch" CornerRadius="3"
                              DisplayMemberPath="Name" SelectionChanged="DeviceChanged" />
                </StackPanel>

                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Visibility="Collapsed" />

                <Border x:Name="NoticeBanner" Visibility="Collapsed" CornerRadius="3" Padding="9,7" BorderThickness="1"
                        Background="{ThemeResource StudioInfoSoftBrush}"
                        BorderBrush="{ThemeResource StudioInfoBrush}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="NoticeIcon" Glyph="&#xE946;" FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0"
                                  Foreground="{ThemeResource StudioInfoBrush}" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="NoticeTitle" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                            <TextBlock x:Name="NoticeMessage" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                                       Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="FormatPanel" Visibility="Collapsed" Spacing="8">
                    <StackPanel>
                        <TextBlock x:Name="ResolutionLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox x:Name="ResolutionPicker" HorizontalAlignment="Stretch" CornerRadius="3"
                                  DisplayMemberPath="Label" SelectionChanged="VideoOptionsChanged" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="FrameRateLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox x:Name="FrameRatePicker" HorizontalAlignment="Stretch" CornerRadius="3"
                                  DisplayMemberPath="Label" SelectionChanged="VideoOptionsChanged" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="ColorSpaceLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox x:Name="ColorSpacePicker" HorizontalAlignment="Stretch" CornerRadius="3"
                                  DisplayMemberPath="Label" SelectionChanged="VideoOptionsChanged" />
                    </StackPanel>
                </StackPanel>

                <Border x:Name="PreviewUnavailableBanner" Visibility="Collapsed" CornerRadius="3" Padding="9,7"
                        Background="{ThemeResource StudioCautionSoftBrush}"
                        BorderBrush="{ThemeResource StudioCautionBrush}" BorderThickness="1">
                    <TextBlock x:Name="PreviewUnavailable" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                </Border>

                <Border x:Name="RecordingHintBanner" Visibility="Collapsed" CornerRadius="3" Padding="9,7"
                        Background="{ThemeResource StudioPanelSecondaryBrush}"
                        BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1">
                    <TextBlock x:Name="RecordingHint" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                </Border>

                <Button x:Name="OpenRecordingReportButton" Visibility="Collapsed" HorizontalAlignment="Stretch"
                        Style="{StaticResource StudioTransportPrimaryButtonStyle}" MinHeight="30"
                        Click="OpenRecordingReportClicked" />
            </StackPanel>
        </Border>

        <!-- Card 2: Collapsible Camera Controls -->
        <Border x:Name="CameraControlsCard" Style="{StaticResource StudioInspectorCardStyle}" Visibility="Collapsed">
            <StackPanel Spacing="8">
                <Button x:Name="CameraControlsToggleButton" Style="{StaticResource SubtleButtonStyle}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="2,2" CornerRadius="3" Click="CameraControlsToggle_Click">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CameraControlsHeading" Style="{StaticResource StudioSectionHeadingStyle}"
                                   VerticalAlignment="Center" />
                        <Border x:Name="CameraPendingBadge" Grid.Column="1" Visibility="Collapsed" CornerRadius="2"
                                Padding="5,1" VerticalAlignment="Center"
                                Background="{ThemeResource StudioCautionSoftBrush}"
                                BorderBrush="{ThemeResource StudioCautionBrush}" BorderThickness="1">
                            <TextBlock x:Name="CameraPendingBadgeText" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{ThemeResource StudioCautionBrush}" />
                        </Border>
                        <FontIcon x:Name="CameraControlsChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="10"
                                  Foreground="{ThemeResource StudioTextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <StackPanel x:Name="CameraControlsBody" Visibility="Collapsed" Spacing="8">
                    <TextBlock x:Name="CameraControlsStatus" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                               Foreground="{ThemeResource StudioTextSecondaryBrush}" />

                    <StackPanel x:Name="CameraControlPickerGroup" Visibility="Collapsed">
                        <TextBlock x:Name="CameraControlPickerLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox x:Name="CameraControlPicker" HorizontalAlignment="Stretch" CornerRadius="3"
                                  DisplayMemberPath="Label" SelectionChanged="CameraControlChanged" />
                    </StackPanel>

                    <CheckBox x:Name="CameraControlAuto" MinWidth="0" Visibility="Collapsed"
                              Checked="CameraControlAutoChanged" Unchecked="CameraControlAutoChanged" />

                    <StackPanel x:Name="CameraControlChoicesGroup" Visibility="Collapsed">
                        <TextBlock x:Name="CameraControlChoicesLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox x:Name="CameraControlChoices" HorizontalAlignment="Stretch" CornerRadius="3"
                                  DisplayMemberPath="Label" SelectionChanged="CameraControlChoiceChanged" />
                    </StackPanel>

                    <StackPanel x:Name="CameraControlValueGroup" Visibility="Collapsed" Spacing="2">
                        <TextBlock x:Name="CameraControlValueLabel" FontSize="12"
                                   Style="{StaticResource StudioMonoTextStyle}"
                                   Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                        <Slider x:Name="CameraControlValue" SnapsTo="StepValues"
                                ValueChanged="CameraControlValueChanged" />
                    </StackPanel>

                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ApplyCameraControlButton" Style="{StaticResource StudioTransportPrimaryButtonStyle}"
                                MinHeight="28" Padding="10,0" HorizontalAlignment="Stretch"
                                Click="ApplyCameraControlClicked" Visibility="Collapsed" />
                        <Button x:Name="ResetCameraControlButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}"
                                Height="28" Padding="8,0" CornerRadius="3" FontSize="12"
                                Click="ResetCameraControlClicked" Visibility="Collapsed" />
                        <Button x:Name="RefreshCameraControlsButton" Grid.Column="2" Style="{StaticResource StudioIconButtonStyle}"
                                Width="28" Height="28" Click="RefreshCameraControlsClicked">
                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                        </Button>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Card 3: Collapsible Format Details & Diagnostics -->
        <Border x:Name="DetailsCard" Style="{StaticResource StudioInspectorCardStyle}" Visibility="Collapsed">
            <StackPanel Spacing="8">
                <Button x:Name="DetailsToggleButton" Style="{StaticResource SubtleButtonStyle}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="2,2" CornerRadius="3" Click="DetailsToggle_Click">
                    <Grid>
                        <TextBlock x:Name="DetailsHeading" Style="{StaticResource StudioSectionHeadingStyle}"
                                   VerticalAlignment="Center" />
                        <FontIcon x:Name="DetailsChevron" HorizontalAlignment="Right" Glyph="&#xE70D;" FontSize="10"
                                  Foreground="{ThemeResource StudioTextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <StackPanel x:Name="DetailsBody" Visibility="Collapsed" Spacing="8">
                    <StackPanel x:Name="VideoStreamGroup" Visibility="Collapsed">
                        <TextBlock x:Name="VideoStreamLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox x:Name="VideoStreamPicker" HorizontalAlignment="Stretch" CornerRadius="3"
                                  DisplayMemberPath="Label" SelectionChanged="VideoOptionsChanged" />
                    </StackPanel>
                    <StackPanel x:Name="VideoFormatGroup" Visibility="Collapsed">
                        <TextBlock x:Name="VideoFormatLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox x:Name="VideoFormatPicker" HorizontalAlignment="Stretch" CornerRadius="3"
                                  DisplayMemberPath="Label" SelectionChanged="FormatChanged" />
                    </StackPanel>
                    <StackPanel x:Name="AudioGroup" Visibility="Collapsed">
                        <TextBlock x:Name="AudioLabel" Style="{StaticResource StudioFieldLabelStyle}" />
                        <ComboBox x:Name="AudioPicker" HorizontalAlignment="Stretch" CornerRadius="3"
                                  DisplayMemberPath="Label" SelectionChanged="FormatChanged" />
                    </StackPanel>

                    <StackPanel x:Name="ResultPanel" Spacing="8">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="NegotiateButton" Style="{StaticResource StudioTransportPrimaryButtonStyle}"
                                    MinHeight="28" Padding="8,0" HorizontalAlignment="Stretch" FontSize="12"
                                    Click="NegotiateClicked" />
                            <Button x:Name="SampleButton" Grid.Column="1" Style="{StaticResource StudioTransportPrimaryButtonStyle}"
                                    MinHeight="28" Padding="8,0" HorizontalAlignment="Stretch" FontSize="12"
                                    Click="SampleClicked" />
                        </Grid>

                        <Border CornerRadius="3" Padding="9,8"
                                Background="{ThemeResource StudioPanelSecondaryBrush}"
                                BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1">
                            <StackPanel Spacing="7">
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="AdvertisedHeading" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                    <TextBlock x:Name="AdvertisedText" Style="{StaticResource StudioMonoTextStyle}"
                                               FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                                </StackPanel>
                                <Border Height="1" Background="{ThemeResource StudioSubtleBorderBrush}" />
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="NegotiatedHeading" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                    <TextBlock x:Name="NegotiatedText" Style="{StaticResource StudioMonoTextStyle}"
                                               FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                                </StackPanel>
                                <Border Height="1" Background="{ThemeResource StudioSubtleBorderBrush}" />
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="SampleHeading" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                                    <TextBlock x:Name="SampleText" Style="{StaticResource StudioMonoTextStyle}"
                                               FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button x:Name="CopyDiagnosticsButton" Style="{StaticResource SubtleButtonStyle}"
                            Height="28" Padding="9,0" CornerRadius="3" HorizontalAlignment="Left"
                            Click="CopyDiagnosticsClicked">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon x:Name="CopyDiagnosticsIcon" Glyph="&#xE8C8;" FontSize="11" />
                            <TextBlock x:Name="CopyDiagnosticsLabel" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
