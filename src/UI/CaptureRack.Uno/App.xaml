<Application
    x:Class="CaptureRack.Uno.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="UnoStudioBgBrush" Color="#111317" />
            <SolidColorBrush x:Key="UnoStudioPanelBrush" Color="#161920" />
            <SolidColorBrush x:Key="UnoStudioCardBrush" Color="#1C2029" />
            <SolidColorBrush x:Key="UnoStudioHairlineBrush" Color="#272D38" />
            <SolidColorBrush x:Key="UnoStudioAccentBrush" Color="#34D399" />
            <SolidColorBrush x:Key="UnoStudioTextPrimaryBrush" Color="#F3F5F8" />
            <SolidColorBrush x:Key="UnoStudioTextSecondaryBrush" Color="#9BA4B5" />
            <SolidColorBrush x:Key="UnoStudioCautionSoftBrush" Color="#26F59E0B" />
            <SolidColorBrush x:Key="UnoStudioCautionBrush" Color="#F59E0B" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
