<UserControl
    x:Class="CaptureRack.App.Views.PlannedBackendInspectorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource StudioInspectorCardStyle}">
        <StackPanel Spacing="9">
            <Grid>
                <TextBlock x:Name="SectionHeading" Style="{StaticResource StudioSectionHeadingStyle}" VerticalAlignment="Center" />
                <Border HorizontalAlignment="Right" CornerRadius="2" Padding="6,2"
                        Background="{ThemeResource StudioInfoSoftBrush}"
                        BorderBrush="{ThemeResource StudioInfoBrush}" BorderThickness="1">
                    <TextBlock x:Name="StatusText" FontSize="10" FontWeight="SemiBold"
                               Foreground="{ThemeResource StudioInfoBrush}" />
                </Border>
            </Grid>
            <TextBlock x:Name="BackendNameText" FontSize="13" FontWeight="SemiBold"
                       Foreground="{ThemeResource StudioTextPrimaryBrush}" />
            <TextBlock x:Name="BackendDescText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{ThemeResource StudioTextSecondaryBrush}" />
            <TextBlock x:Name="PlannedHintText" FontSize="11" TextWrapping="Wrap"
                       Foreground="{ThemeResource StudioTextMutedBrush}" />
        </StackPanel>
    </Border>
</UserControl>
