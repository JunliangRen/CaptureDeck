<UserControl
    x:Class="CaptureRack.App.Controls.BroadcastMeterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ClipLatchButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource StudioMeterTrackBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource StudioHairlineBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.86" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.72" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MeterModePillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource StudioNeutralPillBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource StudioHairlineBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource StudioTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.85" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="MeterCard" Width="86" Style="{StaticResource StudioInstrumentCardStyle}" Padding="8,10">
        <Grid x:Name="StereoMeterGrid" RowSpacing="6" AutomationProperties.Name="Stereo audio peak meters">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: AUDIO + dBFS or Multi-Channel Mode Selector -->
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StereoHeading" Text="AUDIO" Style="{StaticResource StudioSectionHeadingStyle}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <TextBlock x:Name="UnitLabel" Grid.Column="1" Text="dBFS" FontSize="10" Foreground="{ThemeResource StudioTextMutedBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                <Button x:Name="MeterModeButton" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource MeterModePillButtonStyle}" Visibility="Collapsed">
                    <TextBlock x:Name="MeterModeText" Style="{StaticResource StudioMonoTextStyle}" FontSize="9" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <RadioMenuFlyoutItem x:Name="MeterModeAutoItem" GroupName="MeterDisplayMode"
                                                 IsChecked="True" Click="MeterModeAuto_Click" />
                            <RadioMenuFlyoutItem x:Name="MeterModeAllItem" GroupName="MeterDisplayMode"
                                                 Click="MeterModeAll_Click" />
                            <RadioMenuFlyoutItem x:Name="MeterModeMonitoredItem" GroupName="MeterDisplayMode"
                                                 Click="MeterModeMonitored_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Clickable Per-Channel CLIP Latch Indicators -->
            <Grid x:Name="ClipIndicatorsGrid" Grid.Row="1" ColumnSpacing="3" />

            <!-- Vertical Ballistic Gradient Bars + Peak Hold + dB Scale -->
            <Grid x:Name="MeterRailsHost" Grid.Row="2" ColumnSpacing="3" SizeChanged="MeterRail_SizeChanged" />

            <!-- Clickable Pair Monitor Route Selector Row (visible only when > 2 channels) -->
            <Grid x:Name="PairRouteGrid" Grid.Row="3" ColumnSpacing="3" Visibility="Collapsed" />

            <!-- Monitored Stereo Peak Numeric Readout -->
            <Grid Grid.Row="4" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LeftLevel" Text="—" HorizontalAlignment="Center"
                           Style="{StaticResource StudioMonoTextStyle}" FontSize="10"
                           Foreground="{ThemeResource StudioTextPrimaryBrush}" />
                <TextBlock x:Name="RightLevel" Grid.Column="1" Text="—" HorizontalAlignment="Center"
                           Style="{StaticResource StudioMonoTextStyle}" FontSize="10"
                           Foreground="{ThemeResource StudioTextPrimaryBrush}" />
            </Grid>

            <!-- Visual Stereo Phase Correlation Bar (+ active monitor route tag when > 2 ch) -->
            <StackPanel Grid.Row="5" Spacing="3">
                <Border x:Name="MonitorRouteTag" Visibility="Collapsed" CornerRadius="2" Padding="4,1"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource StudioAccentSoftBrush}"
                        BorderBrush="{ThemeResource StudioAccentBrush}" BorderThickness="1">
                    <TextBlock x:Name="MonitorRouteTagText" Style="{StaticResource StudioMonoTextStyle}"
                               FontSize="9" FontWeight="SemiBold"
                               Foreground="{ThemeResource StudioAccentBrush}" />
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="-1" FontSize="9" Foreground="{ThemeResource StudioTextMutedBrush}" />
                    <TextBlock x:Name="PhaseLevel" Grid.Column="1" Text="—" HorizontalAlignment="Center"
                               Style="{StaticResource StudioMonoTextStyle}" FontSize="10"
                               Foreground="{ThemeResource StudioTextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="+1" FontSize="9" Foreground="{ThemeResource StudioTextMutedBrush}"
                               HorizontalAlignment="Right" />
                </Grid>
                <Grid x:Name="PhaseBarRail" Height="6" SizeChanged="PhaseBarRail_SizeChanged">
                    <Border CornerRadius="1" Background="{ThemeResource StudioMeterTrackBrush}"
                            BorderBrush="{ThemeResource StudioHairlineBrush}" BorderThickness="1" />
                    <Rectangle Width="1" Fill="{ThemeResource StudioTextMutedBrush}"
                               HorizontalAlignment="Center" Opacity="0.6" />
                    <Border x:Name="PhaseIndicatorFill" Height="4" CornerRadius="1"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{ThemeResource StudioSignalLockBrush}" Width="0" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
