<UserControl
    x:Class="CaptureRack.App.Controls.RfPeakMeter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RfClipLatchButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{ThemeResource StudioMeterTrackBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource StudioHairlineBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.86" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Opacity" Value="0.72" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource StudioInstrumentCardStyle}" Padding="6,8">
        <Grid RowSpacing="4" Width="48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="Channel" Text="ADC" Style="{StaticResource StudioSectionHeadingStyle}"
                       FontSize="10" HorizontalAlignment="Center" />
            <Button x:Name="High" Grid.Row="1" Style="{StaticResource RfClipLatchButtonStyle}"
                    AutomationProperties.Name="Positive CLIP" Click="ClearHigh">
                <TextBlock x:Name="HighLabel" Text="+CLIP" Style="{StaticResource StudioMonoTextStyle}"
                           FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextSecondaryBrush}" />
            </Button>
            <Grid Grid.Row="2" ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid VerticalAlignment="Stretch" AutomationProperties.AccessibilityView="Raw">
                    <TextBlock Text="+" Style="{StaticResource StudioMonoTextStyle}" FontSize="9"
                               Foreground="{ThemeResource StudioTextMutedBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" />
                    <TextBlock Text="0" Style="{StaticResource StudioMonoTextStyle}" FontSize="10" FontWeight="Bold"
                               Foreground="{ThemeResource StudioTextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <TextBlock Text="−" Style="{StaticResource StudioMonoTextStyle}" FontSize="9"
                               Foreground="{ThemeResource StudioTextMutedBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Right" />
                </Grid>
                <Border Grid.Column="1" CornerRadius="2"
                        Background="{ThemeResource StudioStageCanvasBrush}"
                        BorderBrush="{ThemeResource StudioMonitorBezelBrush}" BorderThickness="1">
                    <Grid>
                        <Viewbox Stretch="Fill">
                            <Canvas Width="20" Height="200">
                                <Rectangle x:Name="Positive" Width="20" Fill="{ThemeResource StudioSignalLockBrush}" />
                                <Rectangle x:Name="Negative" Width="20" Canvas.Top="100" Fill="{ThemeResource StudioInfoBrush}" />
                                <Rectangle x:Name="HoldHigh" Width="20" Height="2" Fill="#F8FAFC" Opacity="0" />
                                <Rectangle x:Name="HoldLow" Width="20" Height="2" Fill="#F8FAFC" Opacity="0" />
                            </Canvas>
                        </Viewbox>
                        <!-- High-contrast center zero rule visible in both Dark and Light Studio themes -->
                        <Border Height="3" Background="#CC0C0E12" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Border Height="1.5" Background="#E6F8FAFC" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
            <Button x:Name="Low" Grid.Row="3" Style="{StaticResource RfClipLatchButtonStyle}"
                    AutomationProperties.Name="Negative CLIP" Click="ClearLow">
                <TextBlock x:Name="LowLabel" Text="−CLIP" Style="{StaticResource StudioMonoTextStyle}"
                           FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource StudioTextSecondaryBrush}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
