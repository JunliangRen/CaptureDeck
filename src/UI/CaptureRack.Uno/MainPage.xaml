<Page
    x:Class="CaptureRack.Uno.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="840" Padding="28,24,28,28" Spacing="20">
            <TextBlock Text="Offline media QC" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Spacing="8">
                <TextBlock x:Name="InputName" Text="No file selected" TextWrapping="Wrap"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="InputPath" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                           IsTextSelectionEnabled="True" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OpenFileButton" Content="Open file…" Click="OpenFile_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
            <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Title="Ready"
                     Message="Choose a CaptureRack MOV or a TS, TS192, or M2T recording."
                     AutomationProperties.LiveSetting="Polite" />
            <ProgressBar x:Name="Progress" IsIndeterminate="False" Visibility="Collapsed" />
            <StackPanel x:Name="MovResults" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="Reports" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsControl x:Name="Warnings">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ViewLogButton" Content="View QC log" Click="ViewLog_Click" />
                    <Button x:Name="OpenFolderButton" Content="Open report folder" Click="OpenFolder_Click" />
                </StackPanel>
                <StackPanel x:Name="ReportNames" Spacing="3">
                    <TextBlock x:Name="LogName" TextWrapping="Wrap" />
                    <TextBlock x:Name="FrameMd5Name" TextWrapping="Wrap" />
                    <TextBlock x:Name="QctoolsName" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox x:Name="ReportText" Header="QC log" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="monospace" MaxHeight="330" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="TsResults" Spacing="12" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="Transport stream" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="TsFormat" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl x:Name="TsMetrics">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="12" Padding="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="TsFirstErrors" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
                <TextBlock Text="Audio/video decoding was not run for this TS check." TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="SaveTsButton" Content="Save JSON report…" Click="SaveTs_Click" />
                <InfoBar x:Name="TsSaveStatus" IsOpen="False" IsClosable="False"
                         AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
