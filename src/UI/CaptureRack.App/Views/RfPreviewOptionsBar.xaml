<UserControl x:Class="CaptureRack.App.Views.RfPreviewOptionsBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock x:Name="TypeLabel" VerticalAlignment="Center"/>
        <ComboBox x:Name="PreviewTypeBox" VerticalAlignment="Center"/>
        <ComboBox x:Name="VideoStandard" SelectedIndex="0" VerticalAlignment="Center" Visibility="Collapsed">
            <x:String>NTSC</x:String><x:String>PAL</x:String>
        </ComboBox>
        <ComboBox x:Name="VhsProfile" SelectedIndex="0" AutomationProperties.Name="VHS" Visibility="Collapsed">
            <x:String>VHS</x:String><x:String>VHS Hi-Fi</x:String>
        </ComboBox>
        <ComboBox x:Name="FieldView" SelectedIndex="0" AutomationProperties.Name="Field view" Visibility="Collapsed">
            <x:String>Frame</x:String><x:String>Split</x:String><x:String>Field 1</x:String><x:String>Field 2</x:String>
        </ComboBox>
        <ComboBox x:Name="Region" SelectedIndex="0" VerticalAlignment="Center" AutomationProperties.Name="Active / Full">
            <x:String>Active</x:String><x:String>Full</x:String>
        </ComboBox>
        <CheckBox x:Name="CvbsRestore" Content="CVBS 50 Ω" Visibility="Collapsed"/>
        <ComboBox x:Name="BetaProfile" SelectedIndex="0" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Betamax">
            <x:String>Betamax</x:String><x:String>Betamax Hi-Fi</x:String>
        </ComboBox>
        <ComboBox x:Name="LdTrack" SelectedIndex="0" VerticalAlignment="Center" Visibility="Collapsed">
            <x:String>LD · Analog</x:String><x:String>LD · Digital PCM</x:String><x:String>LD · DTS</x:String><x:String>LD · AC-3 RF</x:String>
        </ComboBox>
    </StackPanel>
</UserControl>
