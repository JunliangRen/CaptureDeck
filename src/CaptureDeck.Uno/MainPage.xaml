<Page
    x:Class="CaptureDeck.Uno.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="840" Padding="28,24,28,28" Spacing="20">
            <TextBlock Text="Offline MOV QC" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Spacing="8">
                <TextBlock x:Name="InputName" Text="No MOV selected" TextWrapping="Wrap"
                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="InputPath" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="Collapsed"
                           IsTextSelectionEnabled="True" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="OpenMovButton" Content="Open MOV…" Click="OpenMov_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
            <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Title="Ready"
                     Message="Choose an uncompressed CaptureDeck MOV. Reports are saved beside the source file."
                     AutomationProperties.LiveSetting="Polite" />
            <ProgressBar x:Name="Progress" IsIndeterminate="False" Visibility="Collapsed" />
            <StackPanel x:Name="Results" Spacing="12" Visibility="Collapsed">
                <TextBlock Text="Reports" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsControl x:Name="Warnings">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="ViewLogButton" Content="View QC log" Click="ViewLog_Click" />
                    <Button x:Name="OpenFolderButton" Content="Open report folder" Click="OpenFolder_Click" />
                </StackPanel>
                <StackPanel x:Name="ReportNames" Spacing="3">
                    <TextBlock x:Name="LogName" TextWrapping="Wrap" />
                    <TextBlock x:Name="FrameMd5Name" TextWrapping="Wrap" />
                    <TextBlock x:Name="QctoolsName" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox x:Name="ReportText" Header="QC log" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="monospace" MaxHeight="330" Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
