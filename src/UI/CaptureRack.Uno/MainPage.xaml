<Page
    x:Class="CaptureRack.Uno.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource UnoStudioBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Studio Header Strip -->
        <Border Padding="20,12" Background="{StaticResource UnoStudioPanelBrush}"
                BorderBrush="{StaticResource UnoStudioHairlineBrush}" BorderThickness="0,0,0,1">
            <Grid MaxWidth="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="3"
                            Background="{StaticResource UnoStudioCardBrush}"
                            BorderBrush="{StaticResource UnoStudioHairlineBrush}" BorderThickness="1">
                        <Grid>
                            <Border Width="10" Height="10" CornerRadius="1" BorderThickness="1.5"
                                    BorderBrush="{StaticResource UnoStudioTextSecondaryBrush}" />
                            <Rectangle Width="4" Height="4" RadiusX="1" RadiusY="1" Fill="#E53935" />
                        </Grid>
                    </Border>
                    <StackPanel Spacing="1">
                        <TextBlock Text="CaptureRack QC" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource UnoStudioTextPrimaryBrush}" />
                        <TextBlock Text="Offline MOV &amp; Transport Stream Quality Control" FontSize="11"
                                   Foreground="{StaticResource UnoStudioTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="OpenFileButton" Content="Open file…" Click="OpenFile_Click"
                            Style="{StaticResource AccentButtonStyle}" CornerRadius="4" Padding="13,5" />
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click"
                            CornerRadius="4" Padding="13,5" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="900" Padding="24,18,24,28" Spacing="14">
                <!-- Selected File Card -->
                <Border Background="{StaticResource UnoStudioCardBrush}"
                        BorderBrush="{StaticResource UnoStudioHairlineBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="InputName" Text="No file selected" TextWrapping="Wrap"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource UnoStudioTextPrimaryBrush}" />
                        <TextBlock x:Name="InputPath" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource UnoStudioTextSecondaryBrush}"
                                   Visibility="Collapsed" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>

                <InfoBar x:Name="Status" IsOpen="True" IsClosable="False" Title="Ready"
                         Message="Choose a CaptureRack MOV or a TS, TS192, or M2T recording."
                         AutomationProperties.LiveSetting="Polite" />
                <ProgressBar x:Name="Progress" IsIndeterminate="False" Visibility="Collapsed" />

                <!-- MOV QC Results Card -->
                <Border x:Name="MovResults" Visibility="Collapsed"
                        Background="{StaticResource UnoStudioCardBrush}"
                        BorderBrush="{StaticResource UnoStudioHairlineBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="MOV QC REPORTS" FontSize="11" FontWeight="SemiBold" CharacterSpacing="45"
                                   Foreground="{StaticResource UnoStudioTextSecondaryBrush}" />
                        <ItemsControl x:Name="Warnings">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource UnoStudioCautionSoftBrush}"
                                            BorderBrush="{StaticResource UnoStudioCautionBrush}"
                                            BorderThickness="1" CornerRadius="3" Padding="10,6" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{StaticResource UnoStudioTextPrimaryBrush}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ViewLogButton" Content="View QC log" Click="ViewLog_Click" CornerRadius="4" />
                            <Button x:Name="OpenFolderButton" Content="Open report folder" Click="OpenFolder_Click" CornerRadius="4" />
                        </StackPanel>
                        <Border Background="{StaticResource UnoStudioPanelBrush}"
                                BorderBrush="{StaticResource UnoStudioHairlineBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="12,8">
                            <StackPanel x:Name="ReportNames" Spacing="4">
                                <TextBlock x:Name="LogName" FontFamily="monospace" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock x:Name="FrameMd5Name" FontFamily="monospace" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock x:Name="QctoolsName" FontFamily="monospace" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBox x:Name="ReportText" Header="QC log" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" FontFamily="monospace" FontSize="11"
                                 CornerRadius="3" MaxHeight="340" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Transport Stream Results Card -->
                <Border x:Name="TsResults" Visibility="Collapsed"
                        Background="{StaticResource UnoStudioCardBrush}"
                        BorderBrush="{StaticResource UnoStudioHairlineBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="14">
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="TRANSPORT STREAM DIAGNOSTICS" FontSize="11" FontWeight="SemiBold"
                                       CharacterSpacing="45" Foreground="{StaticResource UnoStudioTextSecondaryBrush}" />
                            <TextBlock x:Name="TsFormat" FontFamily="monospace" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource UnoStudioAccentBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Background="{StaticResource UnoStudioPanelBrush}"
                                BorderBrush="{StaticResource UnoStudioHairlineBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="12,8">
                            <ItemsControl x:Name="TsMetrics">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="0,5"
                                              BorderBrush="#1E242E" BorderThickness="0,0,0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="12"
                                                       Foreground="{StaticResource UnoStudioTextSecondaryBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                       FontFamily="monospace" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource UnoStudioTextPrimaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Border x:Name="TsFirstErrorsCard" Visibility="Collapsed"
                                Background="{StaticResource UnoStudioCautionSoftBrush}"
                                BorderBrush="{StaticResource UnoStudioCautionBrush}" BorderThickness="1"
                                CornerRadius="3" Padding="12,8">
                            <TextBlock x:Name="TsFirstErrors" FontFamily="monospace" FontSize="12"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       Foreground="{StaticResource UnoStudioTextPrimaryBrush}" />
                        </Border>
                        <TextBlock Text="Audio/video decoding was not run for this TS check." FontSize="12"
                                   TextWrapping="Wrap" Foreground="{StaticResource UnoStudioTextSecondaryBrush}" />
                        <Button x:Name="SaveTsButton" Content="Save JSON report…" Click="SaveTs_Click" CornerRadius="4" />
                        <InfoBar x:Name="TsSaveStatus" IsOpen="False" IsClosable="False"
                                 AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
